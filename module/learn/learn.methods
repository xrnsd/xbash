#!/opt/homebrew/bin/bash
[[ -f "$rFilePathXbashModuleLearnCommon" ]] && source $rFilePathXbashModuleLearnCommon
##################################################
##                                              ##
##             learn tools                      ##
##                                              ##
##################################################

initLearnEnv()
{
    [[ -n $dirPathTempEng ]] && return
    export dirPathTempEng=$(ftIniEditUtil -r  $rFilePathXbashDBUser learnConfigInfo dirPathRootExampleSentence)      
}

_ftLearnRepetionDrill()
{
    local ftEffect=ftLearnRepetionDrill\'sArgumentAppend
    local cur prev words

    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    case "${prev}" in
        --type )
            COMPREPLY=( $(compgen -W "article sentence imitate" -- "$cur") )
            ;;
        --sort )
            COMPREPLY=( $(compgen -W "order random" -- "$cur") )
            ;;
        --asr )
            COMPREPLY=( $(compgen -W "vosk sherpa_onnx" -- "$cur") )
            ;;
        article | sentence | imitate )
            COMPREPLY=( $(compgen -W "-te -htc -hte -pl -fq --sort --asr" -- "$cur") )
            ;;
        * )
            (( $COMP_CWORD>3 )) && COMPREPLY=( $(compgen -W "-te -htc -hte -pl --sort --asr" -- "$cur") ) ||\
            COMPREPLY=( $(compgen -W "-h --type --help" -- "$cur") )
            ;;
    esac

}
complete -F _ftLearnRepetionDrill ftLearnRepetionDrill
ftLearnRepetionDrill()
{
    local ftEffect="EnglishRepetionDrill"
    local isEnable=true

    [[ "$isEnable" != "true" ]] && ftEcho -s "${ftEffect} Disabled, please confirm" && return
    #check argument
    initLearnEnv
    [[ -z $dirPathTempEng ]] && ftEcho -e "There are not data storge path" && return
    local contentType operateMode readTimeOut orderType=random asrApiType=sherpa_onnx
    local isShowChineseTips=true isShowEnglishTips=true isPlayChineseTips=false isAutomaticSwitching=false
    local isOperateTextEdit=false isOperateAutoBcompare=false isOperatePlayAudio=false isOperateImitateCreate=false
    local valCount=9 errorContent arg arg2
    for ((i=1;i<=$#;i++)) ; do eval arg=\${${i}} ; eval arg2=\${$((i+1))}
    [[ $arg =~ ^\- ]] && case "${arg}" in
        # help information ==============
        -h | --help) ftEcho -rc "${ftEffect}" "'s help information" "\
#=========================================================
#    ftLearnRepetionDrill -h/--help     #view help
#
#    #single-choice parameter:content type
#    ftLearnRepetionDrill --type article      #using text exercises
#                                imitate      #using similar text exercises
#                                sentence     #using sentence exercises
#
#    #multiple-choice parameter
#    ftLearnRepetionDrill -te      #drill by text editor
#                         -htc     #drill by hide chinese tips
#                         -hte     #drill by hide english tips
#                         -pl _/cn #play audio(normal en),enter cn to play chinese audio
#                         -fq xx   #automatic frequency switching in seconds
#                         --sort order/random #sort selection
#                         --asr  vosk/sherpa_onnx #asr api
#========================================================="; return ;;
        --rely) ftEcho -rc "${ftEffect}" "‘s dependency description" "\
#=========================================================
#    ${ftEffect} dependent $2
#========================================================="; return ;;
        # argument check and handle ==============
        --type )  contentType="${arg2}"
                case "${contentType}" in
                    article | sentence | imitate )
                        ;;
                    * )  [[ -n $errorContent ]] && errorContent="${errorContent}\\n"
                         errorContent="${errorContent}invalid type aregument :${contentType}"
                         break
                        ;;
                esac
            ;;
        --sort )  orderType="${arg2}"
                case "${orderType}" in
                    order | random )
                        ;;
                    * )  [[ -n $errorContent ]] && errorContent="${errorContent}\\n"
                         errorContent="${errorContent}invalid sort aregument :${orderType}"
                         break
                        ;;
                esac
            ;;
        --asr )  asrApiType="${arg2}"
                case "${asrApiType}" in
                    vosk)  [[ -n $errorContent ]] && errorContent="${errorContent}\\n"
                         errorContent="${errorContent}ASR tool: VOSK is abandoned"
                        ;;
                    sherpa_onnx )
                        ;;
                    * )  [[ -n $errorContent ]] && errorContent="${errorContent}\\n"
                         errorContent="${errorContent}invalid asr aregument :${asrApiType}"
                         break
                        ;;
                esac
            ;;
        -htc ) isShowChineseTips=false
            ;;
        -hte ) isShowEnglishTips=false
            ;;
        -te ) isOperateTextEdit=true
              operateMode="${operateMode}T"
            ;;
        -fq ) isAutomaticSwitching=true
            [[ -n $arg2 ]] && [[ -n $(echo $arg2| gsed -n "/^[0-9]\+$/p") ]] && \
            readTimeOut="${arg2}"
            ;;
        -pl ) [[ -z $(which afplay) ]] && ftLearnRepetionDrill --rely "afplay" && return $resultFail
              [[ -z $(which pbcopy) ]] && ftLearnRepetionDrill --rely "pbcopy" && return $resultFail 
              isOperatePlayAudio=true
              operateMode="${operateMode}L"
              [[ "${arg2}" == "cn" ]] && isPlayChineseTips=true
            ;;
        * ) [[ -n $errorContent ]] && errorContent="${errorContent}\\n"
            errorContent="${errorContent}invalid aregument:${arg}"
             break
            ;; esac;done

    #argument check
    (( $#>$valCount )) && errorContent="${errorContent}\\nThe maximum number of parameters is ${valCount}, now it is $#"
    [[ -z "$contentType" ]] && errorContent="${errorContent}\\ncontentType is not configed"
    [[ -n "$errorContent" ]] && ftEcho -e "${errorContent}" && ftLearnRepetionDrill -h && return $resultFail
    $isPlayChineseTips && isShowChineseTips=true

    local filePathLearnDataBase="${dirPathTempEng}/local.database"
    local filePathLearnDataBaseFailTime
    local filePathDrillTemp=/tmp/Drill.txt
    local filePathCompareTempText=/tmp/tempTextDrill.txt
    local filePathCompareExampleText=/tmp/exampleTextDrill.txt
    local filePathAloudDrillTempAudio=/tmp/aloud_temp_drill.mp3

    #select lesson group
    local groupNameRepetionDrill=needRepetionDrill lessonNameRepetionDrill=understand_read
    local learnLessonGroupList="$(ftIniEditUtil -r  $filePathLearnDataBase learnLessonInfo lessonGroupList)"
    [[ -z $learnLessonGroupList ]] && ftEcho -e "There are no lessons available here" && return
    local lessonGroupNameSel lessonGroupNameSelected="$(ftIniEditUtil -r  $filePathLearnDataBase learnLessonInfo lessonGroupSelected${contentType}${operateMode})"

    ftEcho -c 3 "Select lesson group ,please" "${learnLessonGroupList[@]}" -ch "${lessonGroupNameSelected}"
    [[ -z $publicSelItemContent ]] && ftEcho -e "Null lesson group:${lessonGroupNameSel}" && return
    lessonGroupNameSel=$publicSelItemContent
    ftIniEditUtil -w $filePathLearnDataBase learnLessonInfo "lessonGroupSelected${contentType}${operateMode}" "${lessonGroupNameSel}"
    
    local lessonGroupContentType=$(ftIniEditUtil -r  $filePathLearnDataBase ${lessonGroupNameSel} lessonGroupContentType)
    
    local lessonGroupNameSelReal=$lessonGroupNameSel

    #select lesson
    local indexArray=0 arrayIndexSort
    local learnLessonList="$(ftIniEditUtil -r $filePathLearnDataBase $lessonGroupNameSel lessonList)"
    [[ -z $learnLessonList ]] || [[ $learnLessonList == "none" ]] && ftEcho -e "Null lesson group:${lessonGroupNameSel}" && return

    local lessonNameSelected="$(ftIniEditUtil -r  $filePathLearnDataBase "${lessonGroupNameSel}" lessonSelected${contentType}${operateMode})"

    local isUseDrillingRecord=true operationInfomation
    local lessonNameSel=$(ftIniEditUtil -r $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_lessonName")
    if [[ -n $lessonNameSel ]];then
        local filePathDataItemLinkTable="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}/${contentType}.link_table"
        local lessonMd5Cache=$(ftIniEditUtil -r $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_Md5_${lessonNameSel}")
        local delSel=n isClear=false
        if [[ -s $filePathDataItemLinkTable ]] && [[ -n $lessonMd5Cache ]];then
            if [[ "$lessonMd5Cache" == "$(md5sum $filePathDataItemLinkTable | gawk '{print $1}')" ]];then
                ftEcho -y "Shall you continue the unfinished training ?"
                read -n 1 delSel
                [ -z "${delSel}" ] && delSel=y
            else
                isClear=true
            fi
                
        fi
        if [[ $delSel != "y" ]] || $isClear;then
            isUseDrillingRecord=false
            #delete status
            ftIniEditUtil -d $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_lessonName"
            ftIniEditUtil -d $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_Md5_${lessonNameSel}"
            ftIniEditUtil -d $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceIndexArray"
            ftIniEditUtil -d $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceArrayIndexSort"

            operationInfomation="lesson ${lessonNameSel} cache drill record is force clear"
            sleep 1.5
        fi
        echo
    else
        isUseDrillingRecord=false
    fi
    local keyNameDrillLesson="lessonDrilled${contentType}${operateMode}"
    local learnLessonListDrilled="$(ftIniEditUtil -r $filePathLearnDataBase "${lessonGroupNameSel}" "${keyNameDrillLesson}")"

    if $isUseDrillingRecord;then
        indexArray=$(ftIniEditUtil -r $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceIndexArray")
        arrayIndexSort=($(ftIniEditUtil -r $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceArrayIndexSort"))
    else
        echo
        ftEcho -c 9 "Select lesson , please" "${learnLessonList[@]}" -cs "\U0002705"  "${learnLessonListDrilled[@]}" -ch "${lessonNameSelected}"
        [[ -z $publicSelItemContent ]] && return
        lessonNameSel=$publicSelItemContent
    fi
    ftIniEditUtil -w $filePathLearnDataBase $lessonGroupNameSel "lessonSelected${contentType}${operateMode}" "${lessonNameSel}"

    local dirPathDataItemContentDrillResult="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}/${contentType}.drill_result" \
          filePathDataItemContentDrillResult
    local dirPathDataItemContentAudio \
          filePathDataItemContentAudio filePathDataItemContentAudioSlow filePathDataItemContentAudioVerySlow
    local filePathDataItemContentAudioShare=/share/ftLearnRepetionDrill_share.mp3
    local dirPathDataItemContentTextAnalysis="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}/${contentType}.text_analysis" \
          filePathDataItemContentTextAnalysis
    local filePathDataItemContentTextEnglish="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}/${contentType}.text_english"
    local filePathDataItemContentTextChinese="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}/${contentType}.text_chinese"
    local filePathDataItemContentTextChineseLink
    local filePathDataItemContentLinkType="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}/${contentType}.link_type"
    local filePathDataItemContentLinkTable="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}/${contentType}.link_table"
    local filePathLearnDrillTemp=/tmp/LearnDrillTemp.txt
    local filePathLearnDrillInfoTemp=/tmp/LearnDrillTemp.info
    local filePathCollectAudioBackgroundLock=/tmp/collectAudioBackgroundLock

    # clear
    [[ -n $operationInfomation ]] && ftEcho -s "${operationInfomation}"
    ftEcho -s "Loading......"

    [[ -s $filePathCollectAudioBackgroundLock ]] && rm $filePathCollectAudioBackgroundLock
    
    if [[ ! -f "$filePathDataItemContentTextEnglish" ]]; then
        ftEcho -e "data file not exist :${filePathDataItemContentTextEnglish}"
        ftLearnRepetionDrill -h && return
    fi

    local fileContentEnglishBasic=$(cat $filePathDataItemContentTextEnglish)
    [[ -z $fileContentEnglishBasic ]] && echo -en "Lesson group: ${lessonGroupNameSel}, Lesson: ${lessonNameSel}\
    \nFile path: ${filePathDataItemContentTextEnglish}\
    \nContent type:" && ftEcho -e " ${contentType} is none" \
    && return

    local fileContentChineseBasic=$(cat $filePathDataItemContentTextChinese)
    [[ -z $fileContentChineseBasic ]] &&  echo -en "Lesson group: ${lessonGroupNameSel}, Lesson: ${lessonNameSel}\
    \nFile path: ${filePathDataItemContentTextEnglish}\
    \nContent type:" && ftEcho -e " ${contentType}'s translation is none" \
    && return

    #audio
    local playAudioLanguage="english"
    $isPlayChineseTips && playAudioLanguage="chinese"
    dirPathDataItemContentAudio="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}/${contentType}.audio_${playAudioLanguage}"
    local filePathDataItemContentAudio 
    if $isOperatePlayAudio && [[ ! -d $dirPathDataItemContentAudio ]];then
        mkdir $dirPathDataItemContentAudio
        ftEcho -y "Audio is null. Do you want to create it ? (Press Y/y is create, enter equal to press y)"
        read -n 1 crSel
        [ -z "${crSel}" ] && crSel=y
        if [[ $crSel = "y" ]];then
            ftText2Mp3ByLesson $lessonGroupNameSel $lessonNameSel --type $contentType --lan $playAudioLanguage
        fi
        echo
    fi
    $isOperatePlayAudio && [[ ! -d $dirPathDataItemContentAudio ]] && ftEcho -e "audio directory not exist:${dirPathDataItemContentAudio}" && return

    #auto create drill results storge directory
    [ ! -d "${dirPathDataItemContentDrillResult}" ] && mkdir "${dirPathDataItemContentDrillResult}"

    local indexSort lineIndex failTime
    local englishItem chineseItem drillReultItems englishItemLength
    local drillInfomationTips="Group Lesson Content_type Operation_mode" drillInfomationTipsGone
    local drillInfomationTipsContent="${lessonGroupNameSel} ${lessonNameSel} ${contentType} ${operateMode}"

    local timingStart=$(gdate +%s -d $(gdate +"%H:%M:%S")) timingChang

    #============= the code port of handle article content ==================
    if [[ "$contentType" = "article" ]]; then

        ftTimeConsuming -i
        local filePathDataItemArticleTextExplain="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}/article.text_explain"
        local filePathDataItemArticleVideoExplain="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}/article.mp4"

        if $isOperatePlayAudio && [[ ! -d $dirPathDataItemContentAudio ]]; then
            local dirPathDataItemSentenceSA="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}/sentence.audio_${playAudioLanguage}"
            [[ ! -d $dirPathDataItemSentenceSA ]] && ftEcho -e "audio directory not exist:${dirPathDataItemSentenceSA}" && return
            ln -s $dirPathDataItemSentenceSA $dirPathDataItemContentAudio
        fi

        chineseItem=$(cat $filePathDataItemContentTextChinese)
        englishItem=$(cat $filePathDataItemContentTextEnglish)
        englishItemLength=${#englishItem}

        if $isOperateTextEdit;then
            local filePathTempWriteDrillText=/tmp/TempWriteDrillText

            if [[ "$contentType" = "imitate" ]] && [ -s "${dirPathDataItemContentDrillResult}" ];then
                ftEcho -e "This lesson is exist training record"
                return
            fi

            clear
            echo -e "${drillInfomationTips}"
            echo "${chineseItem}"

            #optimise
            bcompare &
            local windowFlag="bcompare.Beyond Compare" windowId=
            for ((i=1;i<=30;i++)); do
                windowId=$(wmctrl -xl | grep "${windowFlag}"| gawk '{print $1}')
                [[ -n "$windowId" ]] && break
                sleep 0.1
            done
            [[ -z "$windowId" ]] &&ftEcho -e "operate fail" && return
            xdotool windowminimize $windowId > /dev/null

            #input drill result
            ftEcho -s "please write translation"
            echo -n "" > ${filePathTempWriteDrillText}
            gedit --new-window $filePathTempWriteDrillText

            #alignment drill result
            if [[ "$contentType" = "imitate" ]]&&\
                       [[ $lessonGroupContentType = "ImitateTraining" ]];then
                local fileLineCount=$(wc -l < $filePathTempWriteDrillText)
                local filePathTempWriteDrillTextAlignment="${filePathTempWriteDrillText}Alignment"
                echo -n "" > "${filePathTempWriteDrillTextAlignment}"
                for (( index = 1; index <= $fileLineCount; index++ )); do
                    gawk 'NR=="'$index'"' $filePathTempWriteDrillText >> "${filePathTempWriteDrillTextAlignment}"
                    gawk 'NR=="'$index'"' $filePathDataItemContentTextEnglish >> "${filePathTempWriteDrillTextAlignment}"
                done
                gedit "${filePathTempWriteDrillTextAlignment}"
                fileLineCount=$(gsed -n '$=' "${filePathTempWriteDrillTextAlignment}")
                for (( index = 0; index <= $fileLineCount; index+=2 )); do
                    gawk 'NR=="'$index'"' "${filePathTempWriteDrillTextAlignment}" >> "${filePathTempWriteDrillTextAlignment}Example"
                done
                for (( index = 1; index <= $fileLineCount; index+=2 )); do
                    gawk 'NR=="'$index'"' "${filePathTempWriteDrillTextAlignment}" >> "${filePathTempWriteDrillTextAlignment}Temp"
                done

                mv "${filePathTempWriteDrillTextAlignment}Temp" "${filePathTempWriteDrillText}"
                mv "${filePathTempWriteDrillTextAlignment}Example" "${filePathDataItemContentTextEnglish}"
            fi

            #bcompare drill result
            ftEcho -s "please bcompare translation"
            cp $filePathDataItemContentTextEnglish $filePathCompareExampleText
            bcompare "${filePathCompareExampleText}" "${filePathTempWriteDrillText}"

            #save drill records
            if [[ -n $(grep -sn "\+\+" "${filePathCompareExampleText}") ]] \
                    || [[ -n $(grep -sn "\*\*" "${filePathCompareExampleText}") ]] \
                    || [[ -n $(grep -sn "\-\-" "${filePathCompareExampleText}") ]] \
                    && $isOperateTextEdit;then
                    if [[ "$contentType" = "imitate" ]]&&\
                       [[ $lessonGroupContentType = "ImitateTraining" ]];then
                        cp -rf -v "${filePathTempWriteDrillText}" "${dirPathDataItemContentDrillResult}"
                        rm -rf "${filePathDataItemContentTextEnglish}"
                        ftTransformDrillReslt "${filePathCompareExampleText}" "${filePathDataItemContentTextEnglish}" &&\
                        echo -e "\033[1;33mDrill results:\033[0m form tranform finished"
                    else
                        mv "${filePathCompareExampleText}" "${filePathCompareExampleText}_basic"
                        if ftTransformDrillReslt "${filePathCompareExampleText}_basic" "${filePathCompareExampleText}" > /dev/null;then
                            echo -e "\033[1;33mDrill results:\033[0m form tranform finished"
                            rm -rf "${filePathCompareExampleText}_basic"
                            local lineNumList="$(gawk '/\\033\[/{print NR}' $filePathCompareExampleText)"
                            [[ -n $lineNumList ]] && \
                            for lineNum in ${lineNumList[@]}; do
                                filePathDataItemContentDrillResult="${dirPathDataItemContentDrillResult}/${lineNum}.result"
                                gawk 'NR=="'$lineNum'"' "${filePathCompareExampleText}" >> "${filePathDataItemContentDrillResult}"
                                #delete repeate item
                                sort -u "${filePathDataItemContentDrillResult}" > "${filePathDataItemContentDrillResult}_Sort"
                                mv "${filePathDataItemContentDrillResult}_Sort" "${filePathDataItemContentDrillResult}"
                            done && \
                            printf "Line number \033[31m${lineNumList[@]}\033[0m drill records is saved\n"
                        else
                            echo -e "\033[1;33mDrill results:\033[0m form tranform fail"
                        fi

                        #clean drill file
                        rm -rf "${filePathCompareExampleText}_basic"
                        echo -n "" > ${filePathCompareExampleText}
                    fi

                    echo
            elif [[ -n $(grep -sn "\+" "${filePathCompareExampleText}") ]] \
                || [[ -n $(grep -sn "\*" "${filePathCompareExampleText}") ]]\
                || [[ -n $(grep -sn "\-" "${filePathCompareExampleText}") ]] \
                && $isOperateTextEdit;then
                  echo -en "${drillInfomationTips} drill result from error:"
                  ftEcho -e "$(cat $filePathCompareExampleText)"
            else 
                ftEcho -s "cancel translator text from"
            fi
        

        elif $isOperatePlayAudio ;then
            local sentenceAudioIndex=1 sentenceAudioCount=$(gls -1 ${dirPathDataItemContentAudio} | wc -l)
            ((sentenceAudioCount==0)) && ftEcho -e "Can't find audio file in directory: ${dirPathDataItemContentAudio} " && return $resultFail

            local filePathDataItemContentTextEnglishTipsTemp=/tmp/EnglishBasicTipsTemp filePathDataItemSoure
            local englishItemTips isShowChineseTipsLocal=$isShowChineseTips

            if $isOperateTextEdit;then
                ftTextGeditBackground "${filePathLearnDrillTemp}" &
            fi

            while true; do
                ! $isShowChineseTipsLocal && filePathDataItemSoure="${filePathDataItemContentTextChinese}" || filePathDataItemSoure="${filePathDataItemContentTextEnglish}"
                cp $filePathDataItemSoure $filePathDataItemContentTextEnglishTipsTemp
                cp $filePathDataItemSoure ${filePathDataItemContentTextEnglishTipsTemp}2
                while (( $sentenceAudioIndex <= $sentenceAudioCount  )); do
                    timingChang=$(( $(gdate +%s -d $(gdate +"%H:%M:%S"))-$timingStart  ))
                    filePathDataItemContentAudio="${dirPathDataItemContentAudio}/${sentenceAudioIndex}.mp3"
                    [ ! -f "${filePathDataItemContentAudio}" ] && ftEcho -en "can't find audio file:" && echo "${filePathDataItemContentAudio}" && continue

                    englishItem=$(gawk 'NR=="'$sentenceAudioIndex'"' "${filePathDataItemContentTextEnglishTipsTemp}2")
                    [[ -z "$englishItem" ]] && ((sentenceAudioIndex+=1)) && continue
                    englishItemTips="\\\033[1;33m${englishItem}\\\033[0m\\\033[44;37m<<<<<<<<<<\\\033[0m"
                    cp -rf "${filePathDataItemContentTextEnglishTipsTemp}2" "${filePathDataItemContentTextEnglishTipsTemp}"
                    gsed -i "${lineIndex}s/${englishItem}/${englishItemTips}/g" $filePathDataItemContentTextEnglishTipsTemp
                    clear
                    ftEcho -column 5 "${drillInfomationTips} Duration_info" "${drillInfomationTipsContent} ${timingChang}"
                    echo -e "$(cat $filePathDataItemContentTextEnglishTipsTemp)"
                    afplay $filePathDataItemContentAudio
                    sleep 1
                    ((sentenceAudioIndex+=1))
                done
                sentenceAudioIndex=1
                ftEcho -key -n "Q T Any_other_key" "to_quit to_show_tips to_replay"
                read -n 1 playOpt
                case "$playOpt" in
                    q | Q )
                        break;;
                    t | T )
                        $isShowChineseTipsLocal && isShowChineseTipsLocal=true || isShowChineseTipsLocal=false;;
                    * ) ;;
                esac
            done

        elif [[ "$contentType" = "imitate" ]] || [[ $lessonGroupContentType = "ImitateTraining" ]];then

            timingChang=$(( $(gdate +%s -d $(gdate +"%H:%M:%S"))-$timingStart  ))

            local fileLineCount=$(wc -l < $filePathDataItemContentTextEnglish) index=1
            local englishItem
            while true; do
                clear
                ftEcho -column 5 "${drillInfomationTips} Duration_info" "${drillInfomationTipsContent} ${timingChang}"
                echo
                englishItem=$(gawk 'NR=="'$index'"' $filePathDataItemContentTextEnglish)
                echo "${englishItem}" | tr -d '\n' | pbcopy
                echo -e "$(gawk 'NR=="'$index'"' $filePathDataItemContentTextChinese)"
                echo -e "$englishItem"
                echo -e "$(gawk 'NR=="'$index'"' $dirPathDataItemContentDrillResult)"
                echo
                ftEcho -key "W Q Any_other_key" "go_to_previous_item to_quit to_the_next_item"
                read -n 1 operation

                case "$operation" in
                    q | Q ) echo
                            break;;
                    p | P ) (( index>1 )) && (( index-=1 )) || (( index=1 ))
                            continue;;
                    * ) ((index < $fileLineCount)) && (( index+=1 )) || ((  index=1 ));;
                esac
            done

        else
            if ! $isShowChineseTips;then
                ftEcho -e "error argument config, please enbale tips display"
                return
            fi
            if $isOperateTextEdit;then
                ftTextGeditBackground "${filePathLearnDrillTemp}" &
            fi
            while true; do
                timingChang=$(( $(gdate +%s -d $(gdate +"%H:%M:%S"))-$timingStart  ))
                clear
                ftEcho -column 5 "${drillInfomationTips} Duration_info" "${drillInfomationTipsContent} ${timingChang}"
                if [ ! "$(gls -A $dirPathDataItemContentDrillResult)" ];then
                    echo -e "${englishItem}"
                else
                    local fileLineCount=$(wc -l < $filePathDataItemContentTextEnglish)
                    for (( index = 1; index <= $fileLineCount; index++ )); do
                       [ -f "${dirPathDataItemContentDrillResult}/${index}.result" ] && \
                       echo -e $(gawk 'NR=="'1'"' "${dirPathDataItemContentDrillResult}/${index}.result") && continue
                       echo -e $(gawk 'NR=="'$index'"' $filePathDataItemContentTextEnglish)
                    done
                fi
                ftEcho -continue "Press any key display translator"
                clear
                ftEcho -column 5 "${drillInfomationTips} Duration_info" "${drillInfomationTipsContent} ${timingChang}"
                echo -e "${chineseItem}"
                ftEcho -key "Q Any_other_key" "to_quit to_display_English"
                read -n 1 operation
                [[ $operation = "q" ]] || [[ $operation = "Q" ]] && echo && break
            done
        fi

        [[ -z $learnLessonListDrilled ]] && ftEcho -e "handled exception null learnLessonListDrilled" && return

        #save drill time
        echo -n "Today drill time：" ;ftTimeConsuming -s ftLearnRepetionDrill

        #save drill status
        local keyNameDrillLesson="lessonDrilled${contentType}${operateMode}"
        ftIniEditUtil -w $filePathLearnDataBase "${lessonGroupNameSel}" "${keyNameDrillLesson}" "${learnLessonListDrilled[*]}" #\
        # -a -l "$(echo " $lessonNameSel" | gsed 's/ /\n/g'| uniq | sort -u)"

        #clear drilling records
        ftIniEditUtil -d $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_lessonName"
        ftIniEditUtil -d $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceIndexArray"
        ftIniEditUtil -d $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceArrayIndexSort"

        return
    fi

    #============= the code port of handle sentence or imitate content ==================
    if [[ "$contentType" != "sentence" ]] && [[ "$contentType" != "imitate" ]]; then
        ftEcho -s "Flow exception 03:contentType=${contentType}"
        return
    fi

    local fileSizeDataItemContentTextEnglish=$(wc -l < $filePathDataItemContentTextEnglish)
    local fileSizeDataItemContentTextChinese=$(wc -l < $filePathDataItemContentTextChinese)
    if (($fileSizeDataItemContentTextChinese!=$fileSizeDataItemContentTextEnglish)) ; then
        ftEcho -e "Lesson data exception\n\
        fileSizeDataItemContentTextEnglish=${fileSizeDataItemContentTextEnglish}\n\
        fileSizeDataItemContentTextChinese=${fileSizeDataItemContentTextChinese}"
        return;
    fi
    # [[ -z $arrayIndexSort ]] && arrayIndexSort=($(seq 0 $((fileSizeDataItemContentTextEnglish-1)) | gsed 's/ /\n/g' | shuf))
    [[ -z $arrayIndexSort ]] && arrayIndexSort=($(shuf -i 0-$((fileSizeDataItemContentTextEnglish-1))))

    #save drilling info
    ftIniEditUtil -w $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_lessonName" $lessonNameSel
    if [[ -s $filePathDataItemContentLinkTable ]]; then
        local md5_res=$(md5sum "$filePathDataItemContentLinkTable")
        local md5_val=${md5_res%% *}
        ftIniEditUtil -w $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_Md5_${lessonNameSel}" "$md5_val"
    fi
    ftIniEditUtil -w $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceArrayIndexSort" "${arrayIndexSort[*]}"

    if $isOperateTextEdit;then
        ftTextGeditBackground "${filePathLearnDrillTemp}" &
    fi

    local arrayIndexSortSize=${#arrayIndexSort[@]} linkInfo
    local isShowEnglishTipsSingle=false isShowChineseTipsSingle=false
    local isOperatePlayAudioSingle=false isOperatePlayAudioSlow=false isOperatePlayAudioVerySlow=false isOperateCollectAudio=false
    local isCutChineseTipsSingle=false
    local tipsItemsContent audioInfo timeStart timeHandled
    
    local arrayKeysHighlight \
          arrayKeysIgone \
          arrayKeys="Up Down Right D I E L R A W S F" \
          arrayKeyContents="previous_item \
                            show_tips_or_next_item  \
                            play_${playAudioLanguage}_audio \
                            delete_records \
                            change_analysis \
                            hard_express \
                            hard_understand_L \
                            hard_understand_R \
                            hard_read_aloud \
                            word_example \
                            speech_recognition \
                            imitate_ai_create" \
        arrayKeysHighlightLessonFlags=("understand_listen" \
                                       "understand_read" \
                                       "express" \
                                       "read_aloud" \
                                       "word_example") \
        arrayKeysHighlightAll=("L" "R" "E" "A" "W") \
        arrayKeysHighlightAllFlag=("\U0001F9BB" "\U0001F648" "\U0001F92F" "\U0001F444" "\U0001F4CC")

    local operationType drillInfomationTipsTemp drillInfomationTipsContentTemp
    local isSorting sortingType sortingFlag
    local isRefTipsItemsContent isRefKeyTips isRefDrillInfomationTips isAutoSaveDrillingProgressSingle
    local optResultTips

    while (( $indexArray < $arrayIndexSortSize  )); do
        ftTimeConsuming -i
        timingChang=$(( $(gdate +%s -d $(gdate +"%H:%M:%S"))-$timingStart  ))

        #config next item index
        case $orderType in
            order )
                indexSort=$indexArray
                ;;
            random )
                indexSort=${arrayIndexSort[$indexArray]}
                ;;
            *)
                ftEcho -e "invald orderType:${operationType}"
                return
                ;;
        esac
        [[ -z $indexSort ]] && ftEcho -e "indexSort is null,${arrayIndexSortSize}indexArray=${indexArray}\n${arrayIndexSort[@]}" && return
        lineIndex=$((indexSort+1))

        #auto change opteration by content type
        operationType=
        if [[ -s $filePathDataItemContentLinkType ]] || [[ $lessonGroupNameSel = "needRepetionDrill" ]];then
            [[ -f $filePathDataItemContentLinkType ]] && \
                operationType=$(gawk 'NR=="'$lineIndex'"' $filePathDataItemContentLinkType) || \
                operationType=$lessonNameSeloperationType

            filePathLearnDataBaseFailTime="${dirPathTempEng}/needRepetionDrill/${operationType}/${contentType}.database_fail_time"
            case $operationType in
                read_aloud )
                    isShowChineseTips=true
                    isShowEnglishTips=true
                    isOperatePlayAudio=false
                    isOperatePlayAudioSingle=false
                    isOperateCollectAudio=true
                    isOperateImitateCreate=false
                    ;;
                word_aloud )
                    isShowChineseTips=true
                    isShowEnglishTips=true
                    isOperatePlayAudio=false
                    isOperatePlayAudioSingle=false
                    isOperateCollectAudio=true
                    isOperateImitateCreate=false
                    ;;
                understand_listen )
                    isShowChineseTips=false
                    isShowEnglishTips=false
                    isOperatePlayAudio=true
                    isOperatePlayAudioSingle=false
                    isOperateCollectAudio=false
                    isOperateImitateCreate=false
                    ;;
                express )
                    isShowChineseTips=true
                    isShowEnglishTips=false
                    isOperatePlayAudio=false
                    isOperatePlayAudioSingle=false
                    isOperateCollectAudio=false
                    isOperateImitateCreate=true
                    ;;
                understand_read )
                    isShowChineseTips=false
                    isShowEnglishTips=true
                    isOperatePlayAudio=false
                    isOperatePlayAudioSingle=false
                    isOperateCollectAudio=false
                    isOperateImitateCreate=true
                    ;;
                word_example )
                    isShowChineseTips=false
                    isShowEnglishTips=true
                    isOperatePlayAudio=false
                    isOperatePlayAudioSingle=false
                    isOperateCollectAudio=false
                    isOperateImitateCreate=true
                    ;;
                read_imitate )
                    isShowChineseTips=false
                    isShowEnglishTips=true
                    isOperatePlayAudio=false
                    isOperatePlayAudioSingle=false
                    isOperateCollectAudio=false
                    isOperateImitateCreate=true
                    ;;
                *)
                    ftEcho -e "invald operationType:${operationType} \
                    \nfilePathDataItemContentLinkType:${filePathDataItemContentLinkType} \
                    \narrayIndexSort:${arrayIndexSort[@]} \
                    \nfileSizeDataItemContentTextEnglish:${fileSizeDataItemContentTextEnglish} \
                    \nindexSort:${lineIndex}"
                    return
                    ;;
            esac
        fi

        isRefDrillInfomationTips=true
        isRefTipsItemsContent=true
        isAutoSaveDrillingProgressSingle=true
        isRefKeyTips=true

        while true; do
            #drill status information
            if $isRefDrillInfomationTips;then
                englishItem=$(gawk 'NR=="'$lineIndex'"' $filePathDataItemContentTextEnglish)
                [[ -z $englishItem ]] && \
                ftEcho -column 5 "${drillInfomationTips}" "${drillInfomationTipsContent}" && \
                ftEcho -e "line ${lineIndex} content is null" && sleep 1.5 && break
                englishItemLength=${#englishItem}

                chineseItem=$(gawk 'NR=="'$lineIndex'"' $filePathDataItemContentTextChinese)

                unset linkInfo drillInfomationTipsGone
                if [[ -f ${filePathDataItemContentLinkTable} ]];then
                    linkInfo=$(gawk 'NR=="'$lineIndex'"' ${filePathDataItemContentLinkTable})
                    [[ -z $linkInfo ]] && ftEcho -e "invalid item index ${lineIndex}\n arrayIndexSort=${arrayIndexSort[@]}" && return
                fi
                [[ -z $linkInfo ]] && linkInfo="${lessonGroupNameSel}/${lessonNameSel}/${lineIndex}"

                filePathDataItemContentTextChineseLink="${dirPathTempEng}/$(dirname $linkInfo)/${contentType}.text_chinese"

                unset failTime
                if [[ -s $filePathLearnDataBaseFailTime ]];then
                    failTime=($(grep -sn "${linkInfo}\=" $filePathLearnDataBaseFailTime | gawk -F= '{print $2}'))
                    if [[ -z $failTime ]];then
                        failTime=0
                        #写入默认值
                        [[ $(gsed -n '/^$/=' $filePathLearnDataBaseFailTime) = "4" ]] && echo -e "\n" >> $filePathLearnDataBaseFailTime
                        while read failTimeIndex ;do
                          ((failTimeIndex<6))&&continue
                          gsed  -i "${failTimeIndex}i ${linkInfo}=${failTime}" $filePathLearnDataBaseFailTime
                          break
                        done < <(gsed -n '/^$/=' $filePathLearnDataBaseFailTime)
                    elif (( ${#failTime[@]} > 1 ));then
                        ftEcho -e  "The ${operationType}‘s ${contentType} record ${linkInfo} is repeated"
                        return
                    fi
                fi

                filePathDataItemContentAudio="${dirPathDataItemContentAudio}/${lineIndex}.mp3"
                filePathDataItemContentAudioSlow="${dirPathDataItemContentAudio}/${lineIndex}_slow.mp3"
                if $isOperatePlayAudio || $isOperatePlayAudioSingle || $isOperateCollectAudio;then

                    if [[ -f ${filePathDataItemContentLinkTable} ]];then
                        filePathDataItemContentAudioLink="${filePathDataItemContentAudio}"
                        filePathDataItemContentAudioSlowLink="${filePathDataItemContentAudioSlow}"
                        filePathDataItemContentAudio="${dirPathTempEng}/$(dirname $linkInfo)/${contentType}.audio_${playAudioLanguage}/$(basename $linkInfo).mp3"
                        filePathDataItemContentAudioSlow="${filePathDataItemContentAudio%.*}_slow.mp3"
                    fi

                    local statusInfo
                    audioInfo=$(basename "${filePathDataItemContentAudio}")
                    if [[ ! -s $filePathDataItemContentAudio ]]; then
                        statusInfo="create audio : ${audioInfo}"
                        echo " \n${statusInfo}"
                        optResultTips="${optResultTips=}\n${statusInfo} finished"
                        [[ ! -d $(dirname $filePathDataItemContentAudio) ]] && mkdir -p $(dirname $filePathDataItemContentAudio)
                        if $isPlayChineseTips;then
                            ftText2Mp3 -txt "${chineseItem}" -fpm "${filePathDataItemContentAudio}" -speed +40
                        else
                            ftText2Mp3 -txt "${englishItem}" -fpm "${filePathDataItemContentAudio}"
                        fi
                    fi
                    [[ ! -s $filePathDataItemContentAudioLink ]] && ln -s $filePathDataItemContentAudio $filePathDataItemContentAudioLink

                    # audioInfo=$(basename "${filePathDataItemContentAudioSlow}")
                    if [[ ! -s $filePathDataItemContentAudioSlow ]]; then
                        # statusInfo="create audio : ${audioInfo}"
                        statusInfo="create audio : $(basename $filePathDataItemContentAudioSlow)"
                        echo " \n${statusInfo}"
                        #optResultTips="${optResultTips=}\n${statusInfo} finished"
                        ftText2Mp3 -txt "${englishItem}" -fpm "${filePathDataItemContentAudioSlow}" -speed -20 &
                    fi
                    [[ ! -s $filePathDataItemContentAudioSlowLink ]] && ln -s $filePathDataItemContentAudioSlow $filePathDataItemContentAudioSlowLink

                    [[ -s $filePathDataItemContentAudioSlow ]] && [[ -n $audioInfo ]] && audioInfo=$(echo $audioInfo | gsed 's/_/++/g')

                else
                    drillInfomationTipsGone="${drillInfomationTipsGone} Audio"
                fi
                
                ! $isAutomaticSwitching && ((readTimeOut=$englishItemLength+$englishItemLength+$englishItemLength))
                $isAutomaticSwitching && [[ -z $readTimeOut ]] && drillInfomationTipsGone="${drillInfomationTipsGone} Time_out"
                [[ -z $operationType ]] && drillInfomationTipsGone="${drillInfomationTipsGone} Mode_type"

                drillInfomationTipsTemp="${drillInfomationTips} \
                                         Item_index \
                                         Progress \
                                         Duration \
                                         Mode_type \
                                         Time_out \
                                         Fail_time \
                                         Audio \
                                         Link"
                drillInfomationTipsContentTemp="${drillInfomationTipsContent} \
                                                ${lineIndex} \
                                                $(echo "scale=1; $((indexArray+1))* 100 / $arrayIndexSortSize" | bc)% \
                                                ${timingChang} \
                                                ${operationType:-unknow} \
                                                ${readTimeOut:-unknow} \
                                                ${failTime:-unknow} \
                                                ${audioInfo:-unknow} \
                                                ${linkInfo:-unknow}"
            fi

            if $isRefTipsItemsContent;then
                tipsItemsContent=
                rm -rf $filePathLearnDrillInfoTemp

                filePathDataItemContentTextAnalysis=${dirPathDataItemContentTextAnalysis}/${lineIndex}.md
                if $isShowEnglishTips || $isShowEnglishTipsSingle;then
                    if [[ -s "$filePathDataItemContentTextAnalysis" ]];then
                        [[ -z "$(grep -e "\U0001F" $filePathDataItemContentTextAnalysis)" ]] && \
                         [[ $operationType != "word_aloud" ]] && \
                            echo "${englishItem}" >> $filePathLearnDrillInfoTemp
                        $rFilePathXbashModuleBusy $filePathDataItemContentTextAnalysis >> $filePathLearnDrillInfoTemp
                    fi
                    [[ ! -s $filePathLearnDrillInfoTemp ]] && echo "${englishItem}" >> $filePathLearnDrillInfoTemp
                else
                    echo "" >> $filePathLearnDrillInfoTemp
                fi

                if ($isShowChineseTips || $isShowChineseTipsSingle);then
                    local chineseItemLength
                    $isCutChineseTipsSingle && chineseItemLength=${#chineseItem}
                    ( $isShowEnglishTips || $isShowEnglishTipsSingle || [[ $operationType == "express" ]] ) && unset chineseItemLength
                    
                    if [[ -n $chineseItemLength ]];then
                        echo "${chineseItem:0:$((chineseItemLength/2+1))}....." >> $filePathLearnDrillInfoTemp
                    elif [[ -n $(echo "${chineseItem}" | grep "\+\+") ]] \
                        || [[ -n $(echo "${chineseItem}" | grep "\*\*" ) ]] \
                        || [[ -n $(echo "${chineseItem}" | grep "\-\-") ]];then
                       echo "${chineseItem}" > $filePathLearnDrillTemp
                       $rFilePathXbashModuleBusy $filePathLearnDrillTemp >> $filePathLearnDrillInfoTemp
                       echo "" > $filePathLearnDrillTemp
                    else
                        echo -e "${chineseItem}" >> $filePathLearnDrillInfoTemp
                    fi
                    isCutChineseTipsSingle=false
                fi

                tipsItemsContent="$(cat $filePathLearnDrillInfoTemp)"
                [[ -z $tipsItemsContent ]] && tipsItemsContent="null content to display，\033[1;33mListen carefully\033[0m."
            fi

            #config key tips
            if $isRefKeyTips;then
                unset arrayKeysHighlight arrayKeysHighlightFlag arrayKeysIgone
                
                if [[ $lessonGroupNameSel != $groupNameRepetionDrill ]];then
                    arrayKeysIgone="${arrayKeysIgone} D"
                else
                    for item in $lessonNameSel $operationType; do
                        case "$item" in
                            understand_listen ) arrayKeysIgone="${arrayKeysIgone} L"
                                ;;
                            understand_read ) arrayKeysIgone="${arrayKeysIgone} R"
                                ;;
                            express ) arrayKeysIgone="${arrayKeysIgone} E"
                                ;;
                            read_aloud ) arrayKeysIgone="${arrayKeysIgone} A"
                                ;;
                            word_example ) arrayKeysIgone="${arrayKeysIgone} W"
                                ;;
                            *)  ;;
                        esac
                    done
                fi

                ! $isOperateImitateCreate && arrayKeysIgone="${arrayKeysIgone} F"
                $isOperateCollectAudio && arrayKeysIgone="${arrayKeysIgone} S"

                for indexHl in "${!arrayKeysHighlightLessonFlags[@]}"; do
                    [[ -n $(grep -e "^${linkInfo}=" ${dirPathTempEng}/needRepetionDrill/${arrayKeysHighlightLessonFlags[$indexHl]}/${contentType}.database_fail_time) ]] && \
                        arrayKeysHighlight="${arrayKeysHighlight} ${arrayKeysHighlightAll[$indexHl]}" && \
                        arrayKeysHighlightFlag="${arrayKeysHighlightFlag} ${arrayKeysHighlightAllFlag[$indexHl]}"
                done
                [[ -f $filePathDataItemContentTextAnalysis ]] && arrayKeysHighlight="${arrayKeysHighlight} I"
            fi

            if $isAutoSaveDrillingProgressSingle;then
                ftIniEditUtil -w $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceIndexArray" $indexArray
                #ftEcho -s "The drill records is saved"
                unset isAutoSaveDrillingProgressSingle
            fi

            if ( $isRefDrillInfomationTips || $isRefTipsItemsContent || $isRefKeyTips || $isOperateCollectAudio);then
                isRefDrillInfomationTips=false
                isRefTipsItemsContent=false
                isRefKeyTips=false

                clear

                ftEcho -column 5 "${drillInfomationTipsTemp}" "${drillInfomationTipsContentTemp}" "${drillInfomationTipsGone}"
                if $isOperateCollectAudio;then
                    local filePathAudio=$filePathDataItemContentAudio
                    [[ -s $filePathDataItemContentAudioSlow ]] && filePathAudio=$filePathDataItemContentAudioSlow
                    [[ -s $filePathDataItemContentAudioVerySlow ]] && filePathAudio=$filePathDataItemContentAudioVerySlow
                    echo "------------------"
                    [[ -n $optResultTips ]] && echo -e "${optResultTips}\n------------------"
                    [[ -n $tipsItemsContent ]] && ftEcho -s "${tipsItemsContent}"
                    #[[ -n $tipsItemsContent ]] && [[ $operationType = "word_aloud" ]] && ftEcho -s "${tipsItemsContent}"
                    [[ -s $filePathAudio ]] && ln -s $filePathAudio $filePathAloudDrillTempAudio

                    source "${HOME}/pyenv/sherpa_onnx/bin/activate"
                    case "$asrApiType" in
                        vosk )
                            python3 $rFilePathXbashModuleLearnVosk \
                                --model_path "${dirPathPythonVoskModel}" --peference_audio $filePathAudio --peference_text "${englishItem}"
                            ;;
                        sherpa_onnx )
                            python3 $rFilePathXbashModuleLearnSherpaOnnx \
                                --model_path "${dirPathPythonSherpaOnnxModel}" --peference_audio $filePathAudio --peference_text "${englishItem}"
                            ;;
                        *)
                            ftEcho -e "invalid asrApiType : ${asrApiType}" && return ;;
                    esac
                    deactivate
                    echo "------------------"

                else
                    ftEcho -bl "${tipsItemsContent}"
                fi
                ftEcho -key -n "${arrayKeys}" "${arrayKeyContents}" "${arrayKeysIgone}" -hl "${arrayKeysHighlight}" "${arrayKeysHighlightFlag}"
            fi

            ! $isOperateCollectAudio && [[ -n $optResultTips ]] && echo -e "-----------------------------------------------\n${optResultTips}"
            $isOperateCollectAudio && isOperateCollectAudio=false

            timeStart=$(gdate +%s -d $(gdate +"%H:%M:%S"))
            if ! $isOperateCollectAudio && ($isOperatePlayAudio || $isOperatePlayAudioSingle);then
                if $isOperatePlayAudioVerySlow && [[ -s $filePathDataItemContentAudioVerySlow ]];then
                    afplay $filePathDataItemContentAudioVerySlow
                    isOperatePlayAudioVerySlow=false
                elif $isOperatePlayAudioSlow;then
                    [[ -s $filePathDataItemContentAudioSlow ]] && \
                        afplay $filePathDataItemContentAudioSlow || \
                        afplay -r 0.7 $filePathDataItemContentAudio
                    isOperatePlayAudioSlow=false
                else
                    afplay $filePathDataItemContentAudio
                    isOperatePlayAudioSlow=true
                fi
                isOperatePlayAudioSingle=false
            fi

            #write to clipboard
            echo "${englishItem}"| tr -d '\n'| pbcopy

            #ftEcho -key -r2
            unset isSorting sortingType sortingFlag optResultTips
            playOpt=$($rFilePathXbashModuleKey | tr -d '\033')
            # timeHandled=$(gdate +%s -d $(gdate +"%H:%M:%S"))
            # if [[ -n $readTimeOut ]] && ((timeHandled-timeStart >= $readTimeOut));then
            #     playOpt=n
            # fi

            case "$playOpt" in
                d | D )
                    if [[ -n $operationType ]];then
                        ftEcho -y "Are you sure to delete the record ? (press enter normal)"
                        read -n 1 delSel
                        [ -z "${delSel}" ] && delSel=y
                        [[ $delSel != "y" ]] && isRefTipsItemsContent=true && continue

                        #ftTextSetLine -f $filePathDataItemContentTextEnglish -nn $lineIndex
                        #ftTextSetLine -f $filePathDataItemContentTextChinese -nn $lineIndex

                        local filePathLinkTable="${dirPathTempEng}/needRepetionDrill/${operationType}/${contentType}.database_fail_time"
                        local lineIndexFlag=$(grep -sn "^${linkInfo}=" $filePathLinkTable | gawk -F: '{print $1}')
                        gsed -i "${lineIndexFlag}d" $filePathLinkTable
                        optResultTips="${optResultTips}\nThe ${operationType} record : ${linkInfo} is deleted, id : ${lineIndexFlag}"
                    fi
                    if [[ -n $optResultTips ]];then
                        #save progress
                        ftIniEditUtil -w $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_lessonName" $lessonNameSel
                        ftIniEditUtil -w $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_drillTime" "$(gdate +%s -d $(gdate +"%H:%M:%S"))"
                        ftIniEditUtil -w $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceIndexArray" $((indexArray+1))
                        ftIniEditUtil -w $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceArrayIndexSort" "${arrayIndexSort[*]}"
                        break
                    fi
                    ;;
                #go to previous item
                up )
                    (( indexArray>=1 )) && (( indexArray-=2 )) || (( indexArray=0 ))
                    break;;
                #go to next item
                down )
                    local isNextItem=false
                    if $isOperateCollectAudio;then
                        isNextItem=true
                    elif $isAutomaticSwitching;then
                        if ( $isShowChineseTipsSingle || $isShowChineseTips ) && ( $isShowEnglishTipsSingle || $isShowEnglishTips );then
                            isNextItem=true
                        else
                            isShowChineseTipsSingle=true
                            isShowEnglishTipsSingle=true
                            isRefTipsItemsContent=true
                        fi
                    else
                        isNextItem=true
                    fi

                    if $isNextItem;then

                        if [[ -n $failTime ]] && [[ -s $filePathLearnDataBaseFailTime ]];then
                            ftEcho -key -r1 -tips "Do you understand ? (Press down/enter is understand)"

                            #change fail time
                            local val=$((failTime+1)) icon="\U0001F4AA"
                            if [[ $keyValInput = "down" ]] || [[ -z $keyValInput ]];then
                                val=$((failTime-1))
                                icon="\U0001F4AF"
                            fi

                            gsed -i "/^\[failTimeSDR\]/,/^\[/ {/^\[failTimeSDR\]/b;/^\[/b;s ^$linkInfo=.* $linkInfo=$val g;}" $filePathLearnDataBaseFailTime
                            optResultTips="To change ${operationType}'s fail time record : ${linkInfo}=${val} ${icon}"
                        fi
                        break;
                    fi
                    ;;
                #To play audio
                right )isOperatePlayAudioSingle=true
                    ;;
                double_right )
                    #if ( $isOperatePlayAudioSingle || $isOperatePlayAudio );then
                        filePathDataItemContentAudioVerySlow=${dirPathTempEng}/needRepetionDrill/audio/very_slow.audio_english/$(echo "${linkInfo}" | gsed 's/\//_/g').mp3
                        [[ ! -s $filePathDataItemContentAudioVerySlow ]] && \
                             echo "creating ${lineIndex}_very_slow.mp3" && \
                             ftText2Mp3 -txt "${englishItem}" -fpm $filePathDataItemContentAudioVerySlow -speed -50
                        [[ -s $filePathDataItemContentAudioVerySlow ]] && \
                            isOperatePlayAudioVerySlow=true \
                            isOperatePlayAudioSingle=true
                    #fi
                    ;;
                s | S )
                    isOperateCollectAudio=true
                    isRefKeyTips=true
                    isRefTipsItemsContent=false
                    unset tipsItemsContent
                    ;;
                f | F )
                    local filePathExample=${dirPathTempEng}/media/data/English/learnData/needRepetionDrill/read_imitate/AICmd.text_example
                    echo -e "$(cat $filePathExample)\n ${englishItem}"| tr -d '\n'| pbcopy
                    [[ -s $filePathExample ]] && [[ -n $englishItem ]] && optResultTips="The template has been written to the clipboard !"
                    ;;
                #To create word examples
                w | W )
                    sortingFlag="\U0001F4CC"
                    sortingType="word_example"
                    isSorting=true
                    ;;
                #To create (cn2en) sentences hard to express in English
                e | E )
                    sortingFlag="\U0001F92F"
                    sortingType="express"
                    isSorting=true
                    ;;
                #To create (en2cn) sentences hard to understand
                l | L )
                    sortingFlag="\U0001F9BB"
                    sortingType="understand_listen"
                    isSorting=true
                    ;;
                #To create (en2cn) sentences hard to understand
                r | R )
                    sortingFlag="\U0001F648"
                    sortingType="understand_read"
                    isSorting=true
                    ;;
                #To create sentences hard to read aloud
                a | A )
                    sortingFlag="\U0001F444"
                    sortingType="read_aloud"
                    isSorting=true
                    ;;
                #To add sentences analysis
                i | I )
                    # understand_listen \U0001F9BB
                    # understand_read \U0001F648
                    # express \U0001F92F
                    # read_aloud \U0001F444
                    # word_example \U0001F4CC
                    local filePathDataItem
                    [[ ! -d $dirPathDataItemContentTextAnalysis ]] && mkdir $dirPathDataItemContentTextAnalysis
                    if [[ -f $filePathDataItemContentLinkTable ]];then
                        local dirPathDataItemContentTextAnalysisLink="${dirPathTempEng}/$(dirname $linkInfo)/${contentType}.text_analysis"
                        [[ ! -d $dirPathDataItemContentTextAnalysisLink ]] && mkdir -p $dirPathDataItemContentTextAnalysisLink
                        local filePathDataItemContentTextAnalysisLink="${dirPathDataItemContentTextAnalysisLink}/$(basename $linkInfo).md"
                        [[ ! -f $filePathDataItemContentTextAnalysisLink ]] && touch $filePathDataItemContentTextAnalysisLink

                        local dirPathLocal=$(pwd)
                        [[ ! -s $filePathDataItemContentTextAnalysisLink ]] && cd $dirPathDataItemContentTextAnalysis && ln -sf $filePathDataItemContentTextAnalysisLink && cd $dirPathLocal
                        filePathDataItem=$filePathDataItemContentTextAnalysisLink
                    else
                        filePathDataItem="${dirPathDataItemContentTextAnalysis}/${lineIndex}.md"
                    fi

                    if [[ -s $filePathDataItem ]];then
                        local filePathDataItemBasic=/tmp/temp.Analysis
                        cp -rf $filePathDataItem $filePathDataItemBasic
                        [[ $operationType = "express" ]] && open -e $filePathDataItemContentTextChineseLink $filePathDataItem || open -e $filePathDataItem

                        if [[ -n $(diff $filePathDataItemBasic $filePathDataItem) ]];then
                            isRefTipsItemsContent=true
                            isRefKeyTips=true
                        else
                            optResultTips="Cancel operation, analysis isn't change"
                        fi
                        # clear
                        # continue
                    else
                        optResultTips="Cancel operation, analysis is null"
                    fi
                    ;;
                * )
                    ;;
            esac

            if $isSorting && [[ -n ${sortingType} ]];then
                isSorting=false
                if [[ $lessonNameSel != "${sortingType}" ]]; then
                    if [[ -z $linkInfo ]];then
                        optResultTips="Can't add record : linkInfo is null"
                    else

                        local filePathDataItemDBFT="${dirPathTempEng}/needRepetionDrill/${sortingType}/${contentType}.database_fail_time"
            
                        if [[ ! -s $filePathDataItemDBFT ]]||[[ -z $(grep -e "^${linkInfo}=" ${filePathDataItemDBFT}) ]]; then
                            [[ -z $failTime ]] && failTime=0
                            echo "${linkInfo}=${failTime}" >> $filePathDataItemDBFT
                            optResultTips="The ${sortingType} record ${linkInfo} is created, id : $(ftEcho -s $(($(gawk 'END{print NR}' $filePathDataItemDBFT)-5)))"
                        else
                            optResultTips="Cancel operation, repeate ${sortingType} record"
                        fi

                        if [[ ! -s $filePathDataItemContentTextAnalysis ]]||[[ -z $(grep -e "${sortingFlag}$" ${filePathDataItemContentTextAnalysis}) ]]; then
                            if [[ -s $filePathDataItemContentLinkTable ]];then
                                local dirPathDataItemContentTextAnalysisLink="${dirPathTempEng}/$(dirname $linkInfo)/${contentType}.text_analysis"
                                [[ ! -d $dirPathDataItemContentTextAnalysisLink ]] && mkdir -p $dirPathDataItemContentTextAnalysisLink
                                local filePathDataItemContentTextAnalysisLink="${dirPathDataItemContentTextAnalysisLink}/$(basename $linkInfo).md"
                                [[ ! -f $filePathDataItemContentTextAnalysisLink ]] && touch $filePathDataItemContentTextAnalysisLink
                                [[ ! -f $filePathDataItemContentTextAnalysis ]] && ln -sf $filePathDataItemContentTextAnalysisLink $filePathDataItemContentTextAnalysis
                            fi

                            local sortingResultContent="${englishItem}"
                            if [[ -s $filePathLearnDrillTemp ]] && ([[ -n $(grep -sn "\+\+" "${filePathLearnDrillTemp}") ]] \
                                    || [[ -n $(grep -sn "\*\*" "${filePathLearnDrillTemp}" ) ]] \
                                    || [[ -n $(grep -sn "\-\-" "${filePathLearnDrillTemp}") ]]);then
                                [[ ! -d $dirPathDataItemContentTextAnalysis ]] && mkdir $dirPathDataItemContentTextAnalysis
                                [[ -d $dirPathDataItemContentTextAnalysis ]] && echo "* $(gawk 'NR=="'1'"' $filePathLearnDrillTemp) ${sortingFlag}" >> $filePathDataItemContentTextAnalysis && \
                                    optResultTips="${optResultTips}\n${sortingType}:${lineIndex} add finsih"
                                echo "" > $filePathLearnDrillTemp
                            else
                                optResultTips="${optResultTips}\nCancel operation, null sign data"
                            fi
                        else
                            optResultTips="${optResultTips}\nCancel operation, repeate ${sortingType} analysis data"
                        fi
                    fi
                else
                    optResultTips="lesson is disable"
                fi

                isRefTipsItemsContent=true
                isRefKeyTips=true
            fi
        done

        #handle drill result
        if false && [ -s "${filePathLearnDrillTemp}" ];then
            if [[ -n $(grep -sn "\+\+" "${filePathLearnDrillTemp}") ]] \
                || [[ -n $(grep -sn "\*\*" "${filePathLearnDrillTemp}") ]] \
                || [[ -n $(grep -sn "\-\-" "${filePathLearnDrillTemp}") ]] \
                && $isOperateTextEdit;then
                [[ ! -d "${dirPathDataItemContentDrillResult}" ]] && \
                    mkdir -p "${dirPathDataItemContentDrillResult}"
                [[ -d "${dirPathDataItemContentDrillResult}" ]] && \
                    echo "* $(gawk 'NR=="'1'"' $filePathLearnDrillTemp) \U0001F6AB" >> $filePathDataItemContentTextAnalysis

            elif [[ -n $(grep -sn "\+" "${filePathLearnDrillTemp}") ]] \
                || [[ -n $(grep -sn "\*" "${filePathLearnDrillTemp}") ]]\
                || [[ -n $(grep -sn "\-" "${filePathLearnDrillTemp}") ]] \
                && $isOperateTextEdit;then
                  optResultTips="${optResultTips}\nSentence:${lineIndex} drill result from error:"
                  ftEcho -e "$(cat $filePathLearnDrillTemp)"  
            fi
            
            #clearn drill files
            echo -n "" > ${filePathLearnDrillTemp}
        fi

        isShowChineseTipsSingle=false
        isShowEnglishTipsSingle=false
        unset drillResltItem englishItem chineseItem
        (( indexArray+=1 ))

        (( indexArray<fileSizeDataItemContentTextEnglish )) && ftTimeConsuming -s ftLearnRepetionDrill > /dev/null
    done

    #force stop collect audio
    rm -rf $filePathCollectAudioBackgroundLock

    #save drill time
    echo -n "Today drill time：" ;ftTimeConsuming -s ftLearnRepetionDrill

    #save drill status
    local keyNameDrillLesson="lessonDrilled${contentType}${operateMode}"
    for lessonName in ${learnLessonListDrilled}; do
        [[ "$lessonName" = "$lessonNameSel" ]] && unset keyNameDrillLesson && break
    done
    [[ -n $keyNameDrillLesson ]] && ftIniEditUtil -w $filePathLearnDataBase "${lessonGroupNameSel}" "${keyNameDrillLesson}" "${learnLessonListDrilled[*]} $lessonNameSel" #uniq:to del repeating item

    #clean temp drill cache
    [ -f $filePathLearnDrillTemp ] && rm -rf $filePathLearnDrillTemp

    #clear drilling records
    ftIniEditUtil -d $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_lessonName"
    ftIniEditUtil -d $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_Md5_${lessonNameSel}"
    ftIniEditUtil -d $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceIndexArray"
    ftIniEditUtil -d $filePathLearnDataBase ${lessonGroupNameSel} "lessonDrilling${contentType}${operateMode}_sctenceArrayIndexSort"
}

complete -W "-h --help --rely_install -p -l" -A file ftOcrRepetionDrill 
ftOcrRepetionDrill()
{
    local ftEffect=英语图片文本语音合成
    local isEnable=true

    #可用性校验
    [[ "$isEnable" != "true" ]] && ftEcho -s "${ftEffect} 已被禁用，请确认" && return
    #解参验耦
    local flag="."
    local sentence sentenceContent filePath sentenceHeaderFlag=0
    local valCount=4 errorContent arg arg2 # arg3 # arg4
    for ((i=1;i<=$#;i++)) ; do eval arg=\${${i}} ; eval arg2=\${$((i+1))}
    #eval arg3=\${$((i+2))} #; eval arg4=\${$((i+3))}
    case "${arg}" in
        # 说明参数解析部分 ==============
        --rely) ftEcho -rc "${ftEffect}" "的依赖说明" "\
#=========================================================
#    ${ftEffect}依赖包 $2
#    请尝试使用 ftOcrRepetionDrill --rely_install 补全依赖
#========================================================="; return ;;
        --rely_install)
            ftEcho -s "开始补全依赖"
            sudo apt-get install xxxx
            return ;;
        -h | --help) ftEcho -rc "${ftEffect}" "的使用示例" "\
#=========================================================
#    以下[参数对]无先后顺序可任意组合
#
#    ftOcrRepetionDrill -p 图片路径 -l 句子截取长度
#========================================================="; return ;;
        # 变量参数解析部分 ==============
        -p ) filePath="${arg2}"
            ;;
        -l ) sentenceHeaderFlag="${arg2}"
            ;;
    * ) ;; esac;done

    #依赖校验
    [[ -z $(which tesseract) ]] && ftOcrRepetionDrill --rely "tesseract-ocr-eng" && return $resultFail
    #参数校验
    (( $#>$valCount )) && errorContent="${errorContent}\\n参数默认有${valCount}个,当前为$#个" 
    [ ! -f "${filePath}" ] && errorContent="${errorContent}\\n[文件不存在]$filePath"
    [ -n "$errorContent" ] && ftEcho -ea "函数[${ftEffect}]的参数错误${errorContent}\\n请查看下面说明:" && ftOcrRepetionDrill -h && return $resultFail

    #实现主体
    local fileType=${filePath##*.}
    if [[ $fileType != "txt" ]]; then
        ftEcho -s "图片OCR处理中..."
        local filePathTemp=/tmp/ocrTemp
        if tesseract "${filePath}" "${filePathTemp}"; then
            filePath="${filePathTemp}.txt"
        else
            ftEcho -e "OCR处理失败"
            return
        fi
    fi

    ftEcho -s "句子切分中..."
    while read -u 3 -d "$flag" -a sentence;do
      if (( $sentenceHeaderFlag>0 )) && (( ${#sentence[@]}>$sentenceHeaderFlag )); then
          for (( i = 0; i < ${sentenceHeaderFlag}; i++ )); do
            eval word=\${sentence[$i]}
            sentenceContent="${sentenceContent} ${word}"
          done
      else
        sentenceContent=${sentence[@]}
      fi
      ftEcho -sn "开始合成下面句子语音： "
      echo "${sentenceContent}"
      ftEdgeTTs --speed 10 --playContent "${sentenceContent}" > /dev/null
      #重置缓存
      sentenceContent=

      ftEcho -s "是否继续下一句(回车继续/AnyOtherKey取消)"
      read -n 1 sel
      [ -n "${sel}" ] && return
    done 3< $filePath
}

_ftLearnLessonManage()
{
    local ftEffect=ftLearnLessonManage\'sArgumentAppend
    local cur prev words
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    case "$prev" in
        -unl )
            COMPREPLY=( $(compgen -W "$(gls --file-type ${dirPathTempEng}/needRepetionDrill/ |grep / | gawk -F/ '{print $1}') sentence imitate" -- "$cur") )
            ;;
        -aiq )
            COMPREPLY=( $(compgen -W "analysis imitate" -- "$cur") )
            ;;
        -m | -unlt | -ap | -aiq)
            COMPREPLY=( $(compgen -W "$(gls --file-type $dirPathTempEng |grep / | gawk -F/ '{print $1}')" -- "$cur") )
            ;;
        *)  [[ -d ${dirPathTempEng}/${prev} ]] \
            && COMPREPLY=( $(compgen -W "$(gls --file-type ${dirPathTempEng}/${prev} |grep / | gawk -F/ '{print $1}')" -- "$cur") ) \
            || COMPREPLY=( $(compgen -W "-h --help -al -alg -adsp -u -m -unl -unlt -ap -aiq" -- "$cur") )
            ;;
    esac
}

[[ -n $dirPathTempEng ]] && complete -F _ftLearnLessonManage ftLearnLessonManage ||\
complete -W "-h --help -al -alg -adsp -u -m -unlt -ap -acla -acli" -A file ftLearnLessonManage
ftLearnLessonManage()
{
    local ftEffect=LessonManageTool
    local isEnable=true

    #可用性校验
    [[ "$isEnable" != "true" ]] && ftEcho -s "${ftEffect} 已被禁用，请确认" && return
    #解参验耦
    initLearnEnv
    local filePathDataItemSentenceLinkTable
    local lessonGroupNameSel lessonNameSel
    local isAddLessonGroup=false isAddLesson=false isUpdate=false isUpdateDrillLesson=false
    local isMergeLessonGroup=false lessonGroupNameMerge isLessonApply=false isAddDailyStudyPlan=false \
          isCreateLessonAiQuestion=false isUpdateLessonByLinkTable=false
    local valCount=4 errorContent arg arg2 arg3 arg4
    for ((i=1;i<=$#;i++)) ; do eval arg=\${${i}} ; eval arg2=\${$((i+1))};eval arg3=\${$((i+2))};eval arg4=\${$((i+3))}
    [[ $arg =~ ^\- ]] && case "${arg}" in
        -h | --help) ftEcho -rc "${ftEffect}" "的使用示例" "\
#=========================================================
# ftLearnLessonManage -h / --help   #view help information
#                     -al           #add lesson
#                     -alg          #add leesson group
#                     -adsp         #add daily study plan
#                     -u            #update lesson group list and their own lesson list
#                     -aiq  contentType                 #create lesson content type AI question
#                     -unl  lessonName                  #update needRepetionDrill's lesson                      
#                     -m    lessonGroupName             #merge the whole lesson group to a signel lesson
#                     -unlt lessonGroupName lessonName  #update lesson by linkTbale
#                     -ap   lessonGroupName lessonName  #fill in the missing content of the lesson
#========================================================="; return ;;
        # 变量参数解析部分 ==============
        -al)   isAddLesson=true
               ;;
        -alg)  isAddLessonGroup=true
               ;;
        -ap)   isLessonApply=true
               lessonGroupNameSel="${arg2}"
               lessonNameSel="${arg3}"
               ;;
        -adsp) isAddDailyStudyPlan=true
               ;;
        -aiq)  isCreateLessonAiQuestion=true
               lessonContentType="${arg2}"
               lessonGroupNameSel="${arg3}"
               lessonNameSel="${arg4}"
               ;;
        -u)    isUpdate=true
               ;;
        -unl)  isUpdateDrillLesson=true
               lessonNameSel="${arg2}"
               lessonContentType="${arg3}"
               ;;
        -unlt) isUpdateLessonByLinkTable=true
               lessonGroupNameSel="${arg2}"
               lessonNameSel="${arg3}"
               lessonContentType="${arg4}"
               ;;
        -m)    isMergeLessonGroup=true
               lessonGroupNameMerge="${arg2}"
               ;;
        * )    errorContent="${errorContent}\\naregument invalid:${arg}"
               break
               ;; esac;done

    #参数校验
    (( $#>$valCount )) && errorContent="${errorContent}\\n参数数量无效"
    $isMergeLessonGroup && [ -z $lessonGroupNameMerge ] && errorContent="${errorContent}\\n[合并课程集为空]"
    [ -n "$errorContent" ] && ftEcho -e "函数[${ftEffect}]的参数错误${errorContent}\\n请查看下面说明:" && ftLearnLessonManage -h && return $resultFail

    #实现主体
    local filePathLearnDataBase="${dirPathTempEng}/local.database"
    local filePathLearnDataBaseFailTime #="${dirPathTempEng}/fail_time.database"
    local learnLessonGroupList

    if $isAddDailyStudyPlan;then
        local planFlag="Date:$(gdate -d "today" +"%Y%m%d")"
        local filePathLearnPlan="${dirPathTempEng}/learn.text_plan"
        if [[ -n $(grep -sn "$planFlag" $filePathLearnPlan) ]];then
            ftEcho -e "plan ${planFlag} has already been created"
            return
        fi

        local filePathLearnPlan="${dirPathTempEng}/learn.text_plan"
        local trainingTypeList="$(ftIniEditUtil -r  $filePathLearnDataBase TrainingInfo typeList)"
        local learnLessonGroupList="$(ftIniEditUtil -r  $filePathLearnDataBase learnLessonInfo lessonGroupList)"
        local learnLessonList operationContent lessonGroupDailyStudyPlanSelected lessonDailyStudyPlanList
        [[ -z $learnLessonGroupList ]] && ftEcho -e "There are no lessons available here" && return
        
        
        #added plan content to file
        echo -e "\n\nDate:$(gdate -d "today" +"%Y%m%d")" >> $filePathLearnPlan
        echo    "=====================================" >> $filePathLearnPlan

        for trainingTypeItem in ${trainingTypeList[@]}; do
            
            operationContent=$(ftIniEditUtil -r  $filePathLearnDataBase TrainingInfo $trainingTypeItem)
            lessonGroupDailyStudyPlanSelected="$(ftIniEditUtil -r  $filePathLearnDataBase learnLessonInfo lessonGroupDailyStudyPlanSelected${operationContent})"
    
            echo -e -n "-----------------------------------\nplease config" && ftEcho -s " ${trainingTypeItem} training"
            ftEcho -c 3 "Select lesson group ,please" "${learnLessonGroupList[@]}"  -ch "${lessonGroupDailyStudyPlanSelected}"
            [[ -z $publicSelItemContent ]] && return
            lessonGroupNameSel=$publicSelItemContent

            learnLessonList="$(ftIniEditUtil -r $filePathLearnDataBase $lessonGroupNameSel lessonList)"
            [[ -z $learnLessonList ]] || [[ $learnLessonList == "none" ]] && ftEcho -e "Null lesson group:${lessonGroupNameSel}" && return
            echo

            lessonDailyStudyPlanList="$(ftIniEditUtil -r  $filePathLearnDataBase $lessonGroupNameSel "lessonDailyStudyPlan${operationContent}")"
            ftEcho -c 9 "Select lesson , please" "${learnLessonList[@]}" -cmc -cs "ToBePracticed" "${lessonDailyStudyPlanList[@]}"
            [[ -z $publicSelItemContent ]] && return
            lessonNameSel="${publicSelItemContent[@]}"

            ftIniEditUtil -w $filePathLearnDataBase learnLessonInfo "lessonGroupDailyStudyPlanSelected${operationContent}" ${lessonGroupNameSel}
            ftIniEditUtil -w $filePathLearnDataBase ${lessonGroupNameSel} "lessonDailyStudyPlan${operationContent}" "${lessonNameSel[*]}"

            #added plan content to file
            echo " TrainingType : ${trainingTypeItem}" >> $filePathLearnPlan
            echo " Lesson : ${lessonGroupNameSel},${lessonNameSel[@]}" >> $filePathLearnPlan
            echo " DrillResult:unfished" >> $filePathLearnPlan

            case "$trainingTypeItem" in
            "Reading")
                local dailyStudyPlanSentenceIndex=$(ftIniEditUtil -r  $filePathLearnDataBase $lessonGroupNameSel lessonDrillingsentenceread_sctenceIndexArray)
                local dailyStudyPlanSenteceCount=$(ftIniEditUtil -r  $filePathLearnDataBase $lessonGroupNameSel lessonDailyStudyPlansentencereadSenteceCount)
                echo " Demand: Read the book "AnarchyUnbound" for ${dailyStudyPlanSenteceCount} sentences:${dailyStudyPlanSentenceIndex}~"$(($dailyStudyPlanSentenceIndex+$dailyStudyPlanSenteceCount)) >> $filePathLearnPlan
                ;;
            *) local filePathDemand="${dirPathTempEng}/${lessonGroupNameSel}/demand.text_$(echo "$trainingTypeItem" | tr '[A-Z]' '[a-z]')"
                 if [[ -f $filePathDemand ]];then
                    echo " Demand: " >> $filePathLearnPlan
                    local fileSize=$(wc -l < $filePathDemand)
                    for (( i = 1; i <= $fileSize; i++ )); do
                        echo "  $(gawk 'NR=="'$i'"' $filePathDemand)" >> $filePathLearnPlan
                    done
                 fi;;
            esac
            echo " ------------------"   >> $filePathLearnPlan
         done

         ftEcho -s "daily study plan added"
        return
    fi

    if $isLessonApply;then
        ftEcho -s "apply mode"
        if [[ -z $lessonGroupNameSel ]];then
            local learnLessonGroupList="$(ftIniEditUtil -r  $filePathLearnDataBase learnLessonInfo lessonGroupList)"
            [[ -z $learnLessonGroupList ]] && ftEcho -e "There are no lessons available here" && return
            ftEcho -c 3 "Select lesson group ,please" "${learnLessonGroupList[@]}" 
            [[ -z $publicSelItemContent ]] && return
            lessonGroupNameSel=$publicSelItemContent
        fi
        if [[ -z $lessonNameSel ]];then
            local learnLessonList="$(ftIniEditUtil -r $filePathLearnDataBase "${lessonGroupNameSel}" lessonList)"
            [[ -z $learnLessonList ]] || [[ $learnLessonList == "none" ]] && ftEcho -e "Null lesson group:${lessonGroupNameSel}" && return
            echo
            ftEcho -c 9 "Select lesson , please" "${learnLessonList[@]}"
            [[ -z $publicSelItemContent ]] && return
            lessonNameSel=$publicSelItemContent
        fi

        local contentTypeList=("article" "sentence" "imitate")
        local dirPathDataItemBasic="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}"

        local filePathLessonCaretaToolLocal="${dirPathTempEng}/${lessonGroupNameSel}/bash.text_lesson_create"
        if [[ -f "${filePathLessonCaretaToolLocal}" ]];then
            echo -n "Perform local lesson cteate tool:" && ftEcho -s "bash.text_lesson_create"
            . "${filePathLessonCaretaToolLocal}" ${lessonNameSel}
            return
        fi

        local lessonGroupContentType=$(ftIniEditUtil -r  $filePathLearnDataBase ${lessonGroupNameSel} lessonGroupContentType)

        for contentType in ${contentTypeList[@]}; do
             #extra
            [[ "$contentType" = "article" ]] && [[ ! -d "${dirPathDataItemBasic}/${contentType}.audio_english" ]] \
                && ln -sf "${dirPathDataItemBasic}/sentence.audio_english" "${dirPathDataItemBasic}/article.audio_english" \
                && mkdir "${dirPathDataItemBasic}/${contentType}.audio_english"\

            #basic  
            [[ ! -d "${dirPathDataItemBasic}/${contentType}.audio_english" ]] \
                && mkdir "${dirPathDataItemBasic}/${contentType}.audio_english"\
                && ftEcho -s "mkdir "${contentType}.audio_english""

            [[ ! -d "${dirPathDataItemBasic}/${contentType}.drill_result" ]] \
                && mkdir "${dirPathDataItemBasic}/${contentType}.drill_result"\
                && ftEcho -s "mkdir "${contentType}.drill_result""

            [[ ! -f "${dirPathDataItemBasic}/${contentType}.text_chinese" ]] \
                && touch "${dirPathDataItemBasic}/${contentType}.text_chinese"\
                && ftEcho -s "touch "${contentType}.text_chinese""

            [[ ! -f "${dirPathDataItemBasic}/${contentType}.text_english" ]] \
                && touch "${dirPathDataItemBasic}/${contentType}.text_english"\
                && ftEcho -s "touch "${contentType}.text_english""

            [[ ! -d "${dirPathDataItemBasic}/${contentType}.text_analysis" ]] \
                && mkdir "${dirPathDataItemBasic}/${contentType}.text_analysis"\
                && ftEcho -s "touch "${contentType}.text_analysis""

            [[ ! -f "${dirPathDataItemBasic}/${contentType}.text_problem" ]] \
                && touch "${dirPathDataItemBasic}/${contentType}.text_problem"\
                && ftEcho -s "touch "${contentType}.text_problem""
        done

        ftEcho -s "lesson files and directorys are apply finsihed"
        return
    fi

    if $isUpdateLessonByLinkTable;then
        ftEcho -s "update lesson by linkTbale mode"
        if [[ -z $lessonGroupNameSel ]];then
            local learnLessonGroupList="$(ftIniEditUtil -r  $filePathLearnDataBase learnLessonInfo lessonGroupList)"
            [[ -z $learnLessonGroupList ]] && ftEcho -e "There are no lessons available here" && return
            ftEcho -c 3 "Select lesson group ,please" "${learnLessonGroupList[@]}" 
            [[ -z $publicSelItemContent ]] && return
            lessonGroupNameSel=$publicSelItemContent
        fi

        [[ -z $lessonGroupNameSel ]] && ftEcho -e "lessonGroupNameSel is null" && return
        #[[ $lessonGroupNameSel != "needRepetionDrill" ]] && ftEcho -e "invalid lesson group : ${lessonGroupNameSel}" && return

        if [[ -z $lessonNameSel ]];then
            local learnLessonList="$(ftIniEditUtil -r $filePathLearnDataBase "${lessonGroupNameSel}" lessonList)"
            [[ -z $learnLessonList ]] || [[ $learnLessonList == "none" ]] && ftEcho -e "Null lesson group:${lessonGroupNameSel}" && return
            echo
            ftEcho -c 9 "Select lesson , please" "${learnLessonList[@]}"
            [[ -z $publicSelItemContent ]] && return
            lessonNameSel=$publicSelItemContent
        fi

        local contentTypeList=("sentence imitate article")
        [[ -n $lessonContentType ]] && contentTypeList=${lessonContentType[@]}
        
        local dirPathDataItemBasic="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}"

        [[ -z $(find $dirPathDataItemBasic -name *.link_table) ]] && ftEcho -e "invalid lesson : ${lessonGroupNameSel}/${lessonNameSel}, link table isn't exist" && return

        local dirPathLocal="$(pwd)"
        ##delete all files and floders except link_tables
        #cd $dirPathDataItemBasic && ls ${dirPathDataItemBasic} | grep -v ".link_t" | xargs rm -rf  && cd "${dirPathLocal}"

        
        local filePathDataItemLinkTable md5KeyOld md5KeyNow
        local dirPathLessonUpdateByLtCtAE \
              dirPathLessonUpdateByLtCtAC \
              dirPathLessonUpdateByLtCtTA \
              filePathLessonUpdateByLtCtTE \
              filePathLessonUpdateByLtCtTC \
              filePathLessonUpdateByLtCtTP
        local fileSizeLessonSLE lineContent lineContentTE lineContentTC lineContentFailTime lessonLineLindex 
        local lessonPathBasic lessonCtAE lessonCtAC lessonCtTE lessonCtTC lessonCtTA lessonCtTP

        for contentType in ${contentTypeList[@]}; do
            #check
            filePathDataItemLinkTable="${dirPathDataItemBasic}/${contentType}.link_table"
            printf "\033[1;33mcreate linktable content :\033[0m%s" "${contentType}"
            [[ ! -s $filePathDataItemLinkTable ]] && ftEcho -e " failed" && continue
            echo

            #diff
            md5KeyOld=$(ftIniEditUtil -r  $filePathLearnDataBase ${lessonGroupNameSel} "lessonGroupMd5Key_${lessonNameSel}_${contentType}")
            md5KeyNow="$(md5sum $filePathDataItemLinkTable | gawk '{print $1}')"
            # [[ -n $md5KeyOld ]]&&[[ $md5KeyOld = $md5KeyNow ]] && ftEcho -s "Cancel update, don't changed" && continue

            #delete file repeate line
            [[ $lessonNameSel != "review" ]] && [[ -n $(sort $filePathDataItemLinkTable|uniq -dc) ]] && \
                sort -u $filePathDataItemLinkTable > ${filePathDataItemLinkTable}.temp && \
                mv ${filePathDataItemLinkTable}.temp $filePathDataItemLinkTable

            #update
            dirPathLessonUpdateByLtCtAE="${dirPathDataItemBasic}/${contentType}.audio_english"
            dirPathLessonUpdateByLtCtAC="${dirPathDataItemBasic}/${contentType}.audio_chinese"
            dirPathLessonUpdateByLtCtTA="${dirPathDataItemBasic}/${contentType}.text_analysis"
            
            filePathLessonUpdateByLtCtTE="${dirPathDataItemBasic}/${contentType}.text_english"
            filePathLessonUpdateByLtCtTC="${dirPathDataItemBasic}/${contentType}.text_chinese"
            filePathLessonUpdateByLtCtTP="${dirPathDataItemBasic}/${contentType}.text_problem"

            rm -rf "${dirPathLessonUpdateByLtCtAE}" \
                   "${dirPathLessonUpdateByLtCtAC}" \
                   "${dirPathLessonUpdateByLtCtTA}" \
                   "${filePathLessonUpdateByLtCtTE}" \
                   "${filePathLessonUpdateByLtCtTC}" #\
                   #"${filePathLessonUpdateByLtCtTP}"

            mkdir "${dirPathLessonUpdateByLtCtAE}" \
                   "${dirPathLessonUpdateByLtCtAC}" \
                   "${dirPathLessonUpdateByLtCtTA}"

            touch  "${filePathLessonUpdateByLtCtTC}" #\
                   #"${filePathLessonUpdateByLtCtTP}"

            fileSizeLessonSLE=$(wc -l < $filePathDataItemLinkTable)
            for (( lineIndex = 1; lineIndex <= $fileSizeLessonSLE; lineIndex++ )); do
                printf "handling progress: %d%%\r" $((lineIndex*100/$fileSizeLessonSLE))

                lineContent=$(gawk 'NR=="'$lineIndex'"' "${filePathDataItemLinkTable}")

                [[ -z $lineContent ]] && continue

                lessonPathBasic=$(dirname $lineContent)
                lessonLineLindex=$(basename $lineContent)

                lessonCtTE="${dirPathTempEng}/${lessonPathBasic}/${contentType}.text_english"
                lessonCtTC="${dirPathTempEng}/${lessonPathBasic}/${contentType}.text_chinese"

                if [[ -f $lessonCtTE ]];then
                    if [[ -n $(grep -sn "\/" $lessonCtTE) ]];then
                        ftEcho -en "data content is invald:" && ehco -e " / \nlesson path: ${lessonPathBasic}"
                    else
                        lineContentTE=$(gawk 'NR=="'$lessonLineLindex'"' "${lessonCtTE}")
                        [[ -z $lineContentTE ]] && ftEcho -e "STE linecontent is null >> ${lineContent}"
                        [[ -n $lineContentTE ]] && \
                        touch $filePathLessonUpdateByLtCtTE && \
                        ftTextSetLine -f $filePathLessonUpdateByLtCtTE -n $lineIndex -c "${lineContentTE}" > /dev/null
                    fi
                else
                    ftEcho -en "link info:${lineContent}"; ftEcho -en  " is not exist file:"; echo "${contentType}.text_english\nlessonCtTE=${lessonCtTE}\n------------------------------"
                fi

                if [[ -f $lessonCtTC ]];then
                    if [[ -n $(grep -sn "\/" $lessonCtTC) ]];then
                        ftEcho -en "data content is invald:" && ehco -e " / \nlesson path: ${lessonPathBasic}"
                    else
                        lineContentTC=$(gawk 'NR=="'$lessonLineLindex'"' "${lessonCtTC}")
                        [[ -z $lineContentTC ]] \
                                && ftEcho -e "STC linecontent is null >> ${lineContent}" \
                                || ftTextSetLine -f $filePathLessonUpdateByLtCtTC -n $lineIndex -c "${lineContentTC}" > /dev/null
                    fi
                else
                    ftEcho -en "link info:"; echo -n " ${lineContent}"; ftEcho -en  " is not exist file:"; echo -n "${contentType}.text_chinese"
                fi

                lessonCtAE="${dirPathTempEng}/${lessonPathBasic}/${contentType}.audio_english/${lessonLineLindex}.mp3"
                [[ -f $lessonCtAE ]] && ln -s "${lessonCtAE}" "${dirPathLessonUpdateByLtCtAE}/${lineIndex}.mp3"

                lessonCtAC="${dirPathTempEng}/${lessonPathBasic}/${contentType}.audio_chinese/${lessonLineLindex}.mp3"
                [[ -f $lessonCtAC ]] && ln -s "${lessonCtAC}" "${dirPathLessonUpdateByLtCtAC}/${lineIndex}.mp3"

                lessonCtTA="${dirPathTempEng}/${lessonPathBasic}/${contentType}.text_analysis/${lessonLineLindex}.md"
                [[ -f $lessonCtTA ]] && ln -s "${lessonCtTA}" "${dirPathLessonUpdateByLtCtTA}/${lineIndex}.md"

                #lessonCtTP="${dirPathTempEng}/${lessonPathBasic}/${contentType}.text_problem"
                #[[ -f $lessonCtTP ]] && lineContent=$(gawk 'NR=="'$lessonLineLindex'"' "${lessonCtTP}") && ftTextSetLine -f $filePathLessonUpdateByLtCtTP -n $lineIndex -c "${lineContent}" > /dev/null

                # if (( $lineIndex==11  ));then
                #     echo "lessonPathBasic=${lessonPathBasic}"
                #     echo "lessonLineLindex=${lessonLineLindex}"
                #     echo "lessonCtTA=${lessonCtTA}"
                #     echo "localTA=${dirPathLessonUpdateByLtCtTA}/${lineIndex}.md"
                #     return
                # fi
            done

            ftIniEditUtil -w $filePathLearnDataBase ${lessonGroupNameSel} "lessonGroupMd5Key_${lessonNameSel}_${contentType}" "$(md5sum $filePathDataItemLinkTable | gawk '{print $1}')"

            #delete empty line
            [[ -s $filePathLessonUpdateByLtCtTE ]] && grep -v "^$" $filePathLessonUpdateByLtCtTE > ${filePathLessonUpdateByLtCtTE}temp && mv ${filePathLessonUpdateByLtCtTE}temp $filePathLessonUpdateByLtCtTE
            [[ -s $filePathLessonUpdateByLtCtTC ]] && grep -v "^$" $filePathLessonUpdateByLtCtTC > ${filePathLessonUpdateByLtCtTC}temp && mv ${filePathLessonUpdateByLtCtTC}temp $filePathLessonUpdateByLtCtTC
        done

        #clear empty files or empty floders
        cd $dirPathDataItemBasic
        find . -type d -empty | xargs rm -rf
        find ./ -name "*" -type f -size 0c | xargs rm -rf 
        cd "${dirPathLocal}"

        echo
        ftEcho -s "update finished"
        return
    fi

    if $isCreateLessonAiQuestion;then
        [[ -z $lessonContentType ]] && ftEcho -e " cancel create AI question the content type is null " && return
        ftEcho -s "create lesson ${lessonContentType} content AI question mode"
        
        if [[ -z $lessonGroupNameSel ]];then
            local learnLessonGroupList="$(ftIniEditUtil -r  $filePathLearnDataBase learnLessonInfo lessonGroupList)"
            [[ -z $learnLessonGroupList ]] && ftEcho -e "There are no lessons available here" && return
            ftEcho -c 3 "Select lesson group ,please" "${learnLessonGroupList[@]}" 
            [[ -z $publicSelItemContent ]] && return
            lessonGroupNameSel=$publicSelItemContent
        fi
        if [[ -z $lessonNameSel ]];then
            local learnLessonList="$(ftIniEditUtil -r $filePathLearnDataBase "${lessonGroupNameSel}" lessonList)"
            [[ -z $learnLessonList ]] || [[ $learnLessonList == "none" ]] && ftEcho -e "Null lesson group:${lessonGroupNameSel}" && return
            echo
            ftEcho -c 9 "Select lesson , please" "${learnLessonList[@]}"
            [[ -z $publicSelItemContent ]] && return
            lessonNameSel=$publicSelItemContent
        fi

        local filePathLessonSTETempAlQuestion="/tmp/tmp.text_ai_question"
        local dirPathDataItemBasic="${dirPathTempEng}/${lessonGroupNameSel}/${lessonNameSel}"
        local filePathLessonSTE="${dirPathDataItemBasic}/sentence.text_english"
        local fileSizeLessonSTE=$(wc -l < $filePathLessonSTE)
        local lessonGroupTips=$(ftIniEditUtil -r  $filePathLearnDataBase ${lessonGroupNameSel} lessonGroupTips)
        cp -rf $filePathLessonSTE $filePathLessonSTETempAlQuestion      

        case "$lessonContentType" in
            analysis )
                echo -e "\n上面是${lessonGroupTips}的第${lessonNameSel}篇课文或例句。\n请结合课文强调的知识点对每一行的短语和影响意思理解的语法进行说明。\n请只输出${fileSizeLessonSTE}行说明，每行说明无需原文开头无需添加特殊符号。" >> $filePathLessonSTETempAlQuestion
                cat ${filePathLessonSTETempAlQuestion}| pbcopy
                cat ${filePathLessonSTETempAlQuestion}
                ;;
            
            imitate )
                echo -e "\n上面是${lessonGroupTips}的第${lessonNameSel}篇课文。\
                \n请参照课文写一篇英文文章。要求如下\
                \n要求1：文章的句子数量,排版,行数和课文相同。\
                \n要求2：文章中每个句子无需原文开头也无需添加特殊符号。\
                \n要求3：文章中每行开头无需原文开头也无需添加特殊符号。\
                \n要求4：文章中不要出现课文没有的语法。\
                \n要求5：文章的内容尽可能使用和课文内容类似但不同的短语和单词。\
                \n要求6：给出英文文章后同时给一个排版一样的简体中文翻译。" >> $filePathLessonSTETempAlQuestion
                cat ${filePathLessonSTETempAlQuestion}| pbcopy
                cat ${filePathLessonSTETempAlQuestion}
                ;;
            *)
                ftEcho -e "create fail,invald lessonContentType=${lessonContentType}"
                return;;
        esac

        ftEcho "create question finished"
        return
    fi

    if $isMergeLessonGroup;then
        ftEcho -s "merge lesson group mode"

        local dirPathLessonGroupMerge="${dirPathTempEng}/${lessonGroupNameMerge}"
        local dirPathLessonMerge="${dirPathLessonGroupMerge}/merge"
        
        [[ -n $(find $dirPathLessonGroupMerge -name *.text_chinese |xargs grep -sn "\/") ]] || \
        [[ -n $(find $dirPathLessonGroupMerge -name *.text_english |xargs grep -sn "\/") ]] && \
        ftEcho -en "lesson group ${lessonGroupNameMerge} 's data content is invald:" && ehco " / " && return

        if [ -d "${dirPathLessonMerge}" ];then
            ftEcho -y "存在合并课程是否删除(y为删除，回车默认y)"
            read -n 1 delSel
            [ -z "${delSel}" ] && delSel=y
            [[ $delSel != "y" ]] && ftEcho -s "操作取消" && return
            echo
        fi
        rm -rf ${dirPathLessonMerge}
        mkdir ${dirPathLessonMerge}

        local dirPathArrayLesson=($(gls $dirPathLessonGroupMerge|grep -v "merge"))
        [[ -z $dirPathArrayLesson ]] &&\
        ftEcho -en "invald lesson group:" &&echo "${lessonGroup}" && return
        ftEcho -sn "start merge lesson group:" && echo "${lessonGroup}"

        local filePathLessonSTE filePathLessonGroupMergeSTLT="${dirPathLessonGroupMerge}/merge/sentence.link_table"

        for lessonName in ${dirPathArrayLesson[*]} ; do
            filePathLessonSTE="${dirPathLessonGroupMerge}/${lessonName}/sentence.text_english"
            [[ ! -f ${filePathLessonSTE} ]] && ftEcho -en "invalid lesson：" && echo "${lessonName}" && continue

            fileSizeLessonSTE=$(wc -l < $filePathLessonSTE)
            #写入文件
            [[ -n $fileSizeLessonSTE ]] && for (( lineNum=1 ; lineNum <= fileSizeLessonSTE; lineNum++ )); do
                echo "${dirPathLessonGroupMerge}/${lessonName}/${lineNum}" >> $filePathLessonGroupMergeSTLT  
            done
        done

        ftLearnLessonManage -unlt $lessonGroupNameMerge merge
        ftEcho -s "merge finished"
        return
    fi

    if $isUpdateDrillLesson;then
        ftEcho -s "update needRepetionDrill lesson : ${lessonNameSel}"
        case "$lessonNameSel" in
             "review")
                #delete all invalid file or floder
                local dirPathLocal="$(pwd)" \
                      dirPathLessonNeedRepetionDrillReview="${dirPathTempEng}/needRepetionDrill/review"
                #cd $dirPathLessonNeedRepetionDrillReview && ls ${dirPathLessonNeedRepetionDrillReview} | grep -v ".link_table" | xargs rm -rf  && cd "${dirPathLocal}"
                rm -rf "${dirPathLessonNeedRepetionDrillReview}" && mkdir "${dirPathLessonNeedRepetionDrillReview}"

                local arrayIndexSort arrayIndexSortBeganFlag=0 #5
                local lineContent lineIndex filePathLinkTableReview filePathLinkTypeReview filePathCutFlagReview filePathDataItemContentVoskGrammar
                local fileSizeLearnDataBaseFailTime lessonReviewDataItemSize lessonReviewDataItemSizes fileSizeLinkTable fileSizeLinkTableTemp applyFlags
                local type lineFailTimeVal
                local filePathTempLinkTable=/tmp/tempSort.linkTable

                local lessonReviewDataItemFailTimeFlags=($(ftIniEditUtil -r  $filePathLearnDataBase needRepetionDrill lessonReviewDataItemFailTimeFlags))
                [[ -z $lessonReviewDataItemFailTimeFlags ]] && ftEcho -e "lessonReviewDataItemFailTimeFlags is null " && return
                printf "%11s %24s %21s $(ftIniEditUtil -r $filePathLearnDataBase needRepetionDrill lessonReviewDataItemFailTimeFlagTips)\n" "type" "fileName" " "

                cd $dirPathTempEng
                while read filePathLinkTable ;do
                    type=$(basename $(dirname $filePathLinkTable))
                    fileName=$(basename $filePathLinkTable)
                    contentType=${fileName%.*}


                    printf "\033[1;33mcreate\033[0m %-17s\033[1;33m by\033[0m %-27s of " ${type} ${fileName}

                    lessonReviewDataItemSizes=($(ftIniEditUtil -r  $filePathLearnDataBase needRepetionDrill lessonReviewDataItemSize${type}))
                    [[ -z $lessonReviewDataItemSizes ]] && ftEcho -e "${type}'s lessonReviewDataItemSizes is null " && continue
                    unset applyFlags
                    fileSizeLinkTable=$(wc -l < $filePathLinkTable)

                    filePathLinkTableReview="${dirPathLessonNeedRepetionDrillReview}/${contentType}.link_table"
                    filePathLinkTypeReview="${dirPathLessonNeedRepetionDrillReview}/${contentType}.link_type"
                    #filePathCutFlagReview="${dirPathLessonNeedRepetionDrillReview}/${contentType}.cut_flag"

                    for index in "${!lessonReviewDataItemSizes[@]}"; do
                       gsed -n "6,${fileSizeLinkTable}p" $filePathLinkTable | gawk -F'=' ${lessonReviewDataItemFailTimeFlags[$index]} > $filePathTempLinkTable
                       [[ ! -s $filePathTempLinkTable ]] && applyFlags+="0   " && continue
                       lessonReviewDataItemSize=${lessonReviewDataItemSizes[$index]}
                       applyFlags+="$lessonReviewDataItemSize   "
                       (( lessonReviewDataItemSize==0 )) && continue
                       fileSizeLinkTableTemp=$(wc -l < $filePathTempLinkTable)
                       arrayIndexSort=($(seq $((1+arrayIndexSortBeganFlag)) $fileSizeLinkTableTemp | gsed 's/ /\n/g' | shuf))

                        lineIndex=1
                        (($((fileSizeLinkTableTemp-arrayIndexSortBeganFlag))<lessonReviewDataItemSize)) && lessonReviewDataItemSize=$((fileSizeLinkTableTemp-arrayIndexSortBeganFlag))
                        for (( indexRead = 0; indexRead < ${#arrayIndexSort[@]}; indexRead++ )); do
                            lineContent=$(gawk 'NR=="'${arrayIndexSort[indexRead]}'"' $filePathTempLinkTable)
                            [[ -z $lineContent ]] && continue
                            
                            lineFailTimeVal=$(printf "%s" "${lineContent}" | gawk -F= '{print $2}')
                            lineContent=$(printf "%s" "${lineContent}" | gawk -F= '{print $1}')

                            echo "${lineContent}" >> $filePathLinkTableReview
                            echo "${type}" >> $filePathLinkTypeReview
                            #echo "${lessonReviewDataItemFailTimeFlags[$index]}" >> $filePathCutFlagReview
                            (( $((lineIndex++)) == lessonReviewDataItemSize )) && break
                        done
                    done
                    echo -e "\033[1;36m${applyFlags-\U000274E} \033[0m" 

                    #check line count
                    [[ "$(wc -l < $filePathLinkTableReview)" != "$(wc -l < $filePathLinkTypeReview)"  ]] && \
                    ftEcho -en "exception link tbale" && echo "${filePathLinkTableReview}"
                done < <(find needRepetionDrill/ -name ${lessonContentType}*.database_fail_time)

                if [[ -s $filePathDataItemLinkTableVoskGrammar ]];then
                    gawk -F= '!seen[$1]++' $filePathDataItemLinkTableVoskGrammar > ${filePathDataItemLinkTableVoskGrammar}Temp
                    mv ${filePathDataItemLinkTableVoskGrammar}Temp $filePathDataItemLinkTableVoskGrammar
                fi

                printf "\ncreate ${lessonContentType} item:\033[1;33m$(wc -l < $filePathLinkTableReview)\033[0m  "

                # #delete end empty line
                # while read filePathLink ;do
                #     printf %s "$(< $filePathLink)" > ${filePathLink}temp
                #     mv ${filePathLink}temp $filePathLink
                # done < <(find needRepetionDrill/review -name *.link_*)
                # cd $dirPathLocal

                echo
                ftLearnLessonManage -unlt needRepetionDrill review "${lessonContentType}"
                ;;

               *)
                ftLearnLessonManage -unlt needRepetionDrill ${lessonNameSel}
                ;;
        esac

        ftEcho -s "recreate ${lessonNameSel} finished"
        return
    fi
    if $isUpdate; then
        local dirPathLessonGroup dirPathArrayLesson
        local dirPathLocal=$(pwd)
        cd "${dirPathTempEng}"
        learnLessonGroupList=($(gls -d */| gsed 's/\///g'))
        for lessonGroup in ${learnLessonGroupList[*]} ; do
            dirPathLessonGroup="${dirPathTempEng}/${lessonGroup}"
            dirPathArrayLesson=($(gls $dirPathLessonGroup | grep -v 'repetionDrill.hository\|bash.text_lesson_create\|demand.text_writespeak\|demand.text_transcription\|extra_video\|Problem.list'))
            if [[ -z $dirPathArrayLesson ]];then
                ftEcho -s "--------------------------------"
                ftEcho -s "invald lesson group : ${lessonGroup}"
                ftIniEditUtil -d $filePathLearnDataBase "${lessonGroup}"
                continue
            elif [[ -n $(find $dirPathLessonGroup -name *.text_chinese |xargs grep -sn "\/") ]] || \
               [[ -n $(find $dirPathLessonGroup -name *.text_english |xargs grep -sn "\/") ]];then
                ftEcho -s "--------------------------------"
                ftEcho -e "invald content:\ , lesson group : ${lessonGroup}"
                ftIniEditUtil -d $filePathLearnDataBase "${lessonGroup}"
                continue
            fi
            ftEcho -s "--------------------------------"
            echo "lesson group name : ${lessonGroup}"
            echo "lesson list :${dirPathArrayLesson[@]}"
            ftIniEditUtil -w $filePathLearnDataBase "${lessonGroup}" lessonList "${dirPathArrayLesson[*]}"
        done
        ftIniEditUtil -w $filePathLearnDataBase learnLessonInfo  lessonGroupList "${learnLessonGroupList[*]}"
        cd "${dirPathLocal}"
        ftEcho -s "all lesson update finish"
        return
    fi
    if $isAddLessonGroup; then
        [[ -z $dirPathTempEng ]] && ftEcho -e "数据存放路径为空" && return
        ftEcho -r  "请输入课程集名称："
        read lessonGroupName
        lessonGroupName=$(echo $lessonGroupName |gsed s/[[:space:]]//g)
        learnLessonGroupList="$(ftIniEditUtil -r $filePathLearnDataBase learnLessonInfo  lessonGroupList)"
        learnLessonGroupList="${learnLessonGroupList[@]} $lessonGroupName"
        ftIniEditUtil -w $filePathLearnDataBase learnLessonInfo  lessonGroupList "${learnLessonGroupList[*]}"
        ftIniEditUtil -w $filePathLearnDataBase "${lessonGroupName}" lessonList "none"
        #创建课程文件夹
        mkdir -p "${dirPathTempEng}/${lessonGroupName}"

        local lessonGroupContentTypeList="$(ftIniEditUtil -r  $filePathLearnDataBase learnLessonInfo  lessonGroupContentTypeList)"
        ftEcho -c 10 "please select lesson content type" "${lessonGroupContentTypeList[@]}"
        [[ -z $publicSelItemContent ]] && return
        local lessonGroupContentTypeSel=$publicSelItemContent
        ftIniEditUtil -w $filePathLearnDataBase ${lessonGroupNameSel} lessonGroupContentType ${lessonGroupContentTypeSel}

        ftEcho -s "add lesson update finished"
        return
    fi
    if $isAddLesson; then
        [[ -z $dirPathTempEng ]] && ftEcho -e "数据存放路径为空" && return

        learnLessonGroupList="$(ftIniEditUtil -r  $filePathLearnDataBase learnLessonInfo  lessonGroupList)"
        [[ -z $learnLessonGroupList ]] && ftEcho -e "当前没有可供选择的课程" && return
        ftEcho -c 4 "please select lesson group" "${learnLessonGroupList[@]}"
        [[ -z $publicSelItemContent ]] && return
        lessonGroupNameSel=$publicSelItemContent

        ftEcho -r  "please input lesson name："
        read lessonName
        lessonName=$(echo $lessonName |gsed s/[[:space:]]//g)

        local dirPathLessonGroup="${dirPathTempEng}/${lessonGroupNameSel}"
        
        mkdir -p "${dirPathLessonGroup}/${lessonName}" && \
        ftLearnLessonManage -ap "${lessonGroupNameSel}" "${lessonName}"

        local filePathDataItemSentenceTextEnglish="${dirPathLessonGroup}/${lessonName}/sentence.text_english"
        local filePathDataItemSentenceTextChinese="${dirPathLessonGroup}/${lessonName}/sentence.text_chinese"
        local dirPathDataItemSentenceTextAnalysis="${dirPathLessonGroup}/${lessonName}/sentence.text_analysis"

        local filePathDataItemArticleTextEnglish="${dirPathLessonGroup}/${lessonName}/article.text_english"
        local filePathDataItemArticleTextChinese="${dirPathLessonGroup}/${lessonName}/article.text_chinese"

        if [[ ! -s $filePathDataItemSentenceTextEnglish ]] || [[ ! -s $filePathDataItemSentenceTextChinese ]];then
            XMODIFIERS=gnome-text-editor $filePathDataItemSentenceTextEnglish $filePathDataItemSentenceTextChinese $filePathDataItemArticleTextEnglish $filePathDataItemArticleTextChinese && \
            mkdir $dirPathDataItemSentenceTextAnalysis
        fi
        if [[ ! -s $filePathDataItemSentenceTextEnglish ]] || [[ ! -s $filePathDataItemSentenceTextChinese ]]; then
            ftEcho -s "在${lessonGroupNameSel}下新建的课程${lessonName}为空，将删除"
            rm $filePathDataItemSentenceTextEnglish $filePathDataItemSentenceTextChinese $filePathDataItemArticleTextEnglish
            return
        fi
        [[ ! -s $filePathDataItemArticleTextEnglish ]] && ftEcho -e "课程${lessonName}的例文为空"
        if [[ ! -s $filePathDataItemSentenceTextEnglish ]]; then
            ftEcho -y "Should any audio file be created?"
            read -n 1 sel
            case "$sel" in
                y | Y )
                    local filePathText=$filePathDataItemSentenceTextEnglish
                    local dirPathMp3="${dirPathLessonGroup}/${lessonName}/sentence.audio_english"
                    ftText2Mp3 -fpt "${filePathDataItemSentenceTextEnglish}" -dpm "${dirPathMp3}"
                    ;;
                * )
                    ;;
            esac
        fi
        ftLearnLessonManage -u > /dev/null
        ftEcho -s "在${lessonGroupNameSel}下已新建课程${lessonName}"
    fi
}