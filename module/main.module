# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# The loader uses process-local associative state (Homebrew Bash on macOS).
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
    printf 'xbash requires Bash 4.3 or newer\n' >&2
    return 1
fi

# don't put duplicate lines in the history. See bash(1) for more options
# ... or force ignoredups and ignorespace
HISTCONTROL=ignoredups:ignorespace

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
#HISTSIZE=1000
#HISTFILESIZE=2000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" ugsed in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (ugsed in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(< /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
    # We have color support; assume it's compliant with Ecma-48
    # (ISO/IEC-6429). (Lack of such support is extremely rare, and such
    # a case would tend to support setf rather than setaf.)
    color_prompt=yes
    else
    color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to user@host:dir
case "$TERM" in
xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

#added by wgx : xbash初始化
#---------------- 初始化xbash变量 ----------------------------------
    # Resolve the sourced file, including relative .bashrc symlinks, without readlink -f.
    _ftXbashResolveContext()
    {
        local file="$1" directory link home root name depth=0
        while [[ -L "$file" ]]; do
            ((depth+=1))
            (( depth <= 40 )) || { printf 'xbash: symbolic link loop\n' >&2; return 1; }
            directory=$(cd -P -- "$(dirname -- "$file")" && pwd) || return 1
            link=$(command readlink -- "$file") || return 1
            case "$link" in /*) file="$link";; *) file="$directory/$link";; esac
        done
        directory=$(cd -P -- "$(dirname -- "$file")" && pwd) || return 1
        root=$(cd -P -- "$directory/.." && pwd) || return 1
        home=$(cd -P -- "${HOME:?xbash requires HOME}" && pwd) || return 1
        name=${XBASH_CONFIG_USER:-${USER:-${home##*/}}}
        [[ "$name" != */* && "$name" != . && "$name" != .. && -n "$name" ]] || return 1
        [[ -r "$root/config/common.config" ]] || { printf 'xbash: missing common.config\n' >&2; return 1; }
        if [[ ${_xbash_context_pid-} == "$BASHPID" ]] &&
           [[ "$root" != "$rDirPathXbash" || "$home" != "$rDirPathUserHome" || "$name" != "$rUserName" ]]; then
            printf 'xbash: changed path context requires a new shell\n' >&2
            return 1
        fi
        userName=$name
        export dirNameXbash=xbash dirPathHome="$home" dirPathHomeXbash="$root"
        export dirPathHomeTools="$home/tools" dirPathHomeXbashConfig="$root/config"
        export dirPathHomeXbashConfigUser="$root/config/user"
    }
    _ftXbashResolveContext "${BASH_SOURCE[0]}" || return 1

#---------------- 加载xbash配置和基础定义 ------------------
    # The loader is deliberately self-contained: even common.methods can fail.
    _ftXbashSource()
    {
        local file="$1" required="${2:-required}" kind="${3:-module}" status
        if [[ ! -r "$file" ]]; then
            [[ "$required" == optional ]] && return 0
            printf 'xbash: required file is unavailable: %s\n' "$file" >&2
            return 1
        fi
        source "$file"
        status=$?
        # Legacy option files often end in a false condition. New configurations
        # can report failure explicitly with xbashConfigStatus (including 1).
        if [[ "$kind" == config && "$status" == 1 && ${xbashConfigStatus:-0} == 0 ]]; then
            status=0
        fi
        if [[ "$kind" == config && ${xbashConfigStatus:-0} != 0 ]]; then
            status=1
        fi
        if (( status != 0 )); then
            printf 'xbash: loading failed (%s): %s\n' "$status" "$file" >&2
            return "$status"
        fi
        return 0
    }
    if [[ ${_xbash_modules_pid-} != "$BASHPID" ]]; then
        declare -gA _xbash_module_states=()
        _xbash_modules_pid=$BASHPID
        export -n _xbash_modules_pid _xbash_module_states
    fi
    _ftXbashLoadModule()
    {
        local module_file="$1" requirement="${2:-required}" module_status
        case "${_xbash_module_states[$module_file]-}" in
            loaded) return 0;;
            loading) printf 'xbash: circular dependency: %s\n' "$module_file" >&2; return 1;;
        esac
        if [[ ! -r "$module_file" && "$requirement" == optional ]]; then
            _xbash_module_states[$module_file]=unavailable
            return 0
        fi
        _xbash_module_states[$module_file]=loading
        _ftXbashSource "$module_file" "$requirement"
        module_status=$?
        if (( module_status != 0 )); then
            _xbash_module_states[$module_file]=failed
            return "$module_status"
        fi
        _xbash_module_states[$module_file]=loaded
        return 0
    }
    filePathXbashTragetBashrcConfigBase="$dirPathHomeXbashConfig/common.config"
    _ftXbashSource "$filePathXbashTragetBashrcConfigBase" || return $?
    _ftXbashLoadModule "$rFilePathXbashModuleCommon" || return $?
    _ftXbashLoadModule "$rDirPathXbashModuleBase/environment.module" || return $?
    _ftXbashResetOwnedPaths
    unset -f ftXbashApplyUserEnvironment
    filePathUserConfig="$rFilePathXbashConfigUser"
    xbashConfigStatus=0
    _ftXbashSource "$filePathUserConfig" required config || return $?
    if declare -F ftXbashApplyUserEnvironment >/dev/null; then
        ftXbashApplyUserEnvironment || return $?
    fi
    export filePathXbashTragetBashrcConfigProfile="$dirPathHomeXbashConfig/profile.config"

#---------------- 加载扩展 ------------------
    # Optional absent modules provide no capabilities; an existing broken module
    # is an error rather than a successful but partly initialized environment.
    _ftXbashLoadModule "$rFilePathXbashModuleAuto" optional || return $?
    _ftXbashLoadModule "$rFilePathXbashModuleGit" optional || return $?
    _ftXbashLoadModule "$rFilePathXbashModuleUser" optional || return $?
    _ftXbashSource "$rFilePathXbashPackagingUser" optional || return $?
    _ftXbashLoadModule "$rFilePathXbashModuleLearn" optional || return $?

    # Readline configuration belongs to the user. Startup never replaces it.
    if [[ -f "$HOME/.bashrc_config_check" ]]; then
        ftCheckUserConfig || :
        ftCheckUserDatabase || :
        ftCheckUserPackaging || :
    fi
    if declare -F ftAutoConfigOpenAIEnv >/dev/null; then
        ftAutoConfigOpenAIEnv || return $?
    fi

# User-local package managers use the same exact, idempotent PATH operations.
export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
ftXbashPathAdd "$PNPM_HOME" prepend || return $?
ftXbashPathAdd "$HOME/.local/bin" || return $?

# 针对 macOS Terminal.app 的路径跟随修复
if [ "$TERM_PROGRAM" == "Apple_Terminal" ] && [ -f /etc/bashrc_Apple_Terminal ]; then
    . /etc/bashrc_Apple_Terminal
fi

#config lang env
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

return 0
