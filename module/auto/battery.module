#!/opt/homebrew/bin/bash
ftBatteryLevelListener()
{

    # 1. 检查电脑是否处于锁屏或活跃状态 (替代无法读取的 powerstate)
    # 逻辑：如果存在 'CGSSessionScreenIsLocked' 字段，说明已锁屏或黑屏
    IS_LOCKED=$(python3 -c 'import Quartz; d=Quartz.CGSessionCopyCurrentDictionary(); print(d.get("CGSSessionScreenIsLocked", 0))' 2>/dev/null)

    # 如果 IS_LOCKED 为 1，说明屏幕已锁定或熄灭，脚本直接退出
    if [ "$IS_LOCKED" == "1" ]; then
        exit 0
    fi

    # 2. 获取电池数据
    BATT_INFO=$(pmset -g batt)
    BATT_LEVEL=$(echo "$BATT_INFO" | grep -Eo "\d+%" | cut -d% -f1)
    CHARGING_STATUS=$(echo "$BATT_INFO" | grep -o "AC Power\|Battery Power")

    # 3. Low Battery Logic
    LOW_LIMIT=$2
    if [ "$BATT_LEVEL" -le "$LOW_LIMIT" ] && [ "$CHARGING_STATUS" == "Battery Power" ]; then
        # Voice Alert
        say "Battery Low, please plug in" &
        # Side Notification & Center Dialog
        osascript -e "display notification \"Battery level is at $BATT_LEVEL%. Please connect to power.\" with title \"🔋 Low Battery Alert\"" \
                  -e "display dialog \"Your battery is low ($BATT_LEVEL%). Please plug in your charger immediately!\" buttons {\"OK\"} default button \"OK\" with icon caution"
    fi

    # 4. High Battery Logic
    HIGH_LIMIT=$1
    if [ "$BATT_LEVEL" -ge "$HIGH_LIMIT" ] && [ "$CHARGING_STATUS" == "AC Power" ]; then
        # Only alert if the status is actually 'charging' to avoid repeated alerts when full
        if echo "$BATT_INFO" | grep -q "charging"; then
            # Voice Alert
            say "Battery reached eighty percent" &
            # Side Notification & Center Dialog
            osascript -e "display notification \"Battery reached $BATT_LEVEL%. You can unplug the power now.\" with title \"⚡️ Charging Complete\"" \
                      -e "display dialog \"Battery is charged to $BATT_LEVEL%. To extend battery life, it is recommended to unplug now.\" buttons {\"Got it\"} default button \"Got it\" with icon note"
        fi
    fi


}

ftBatteryLevelListener 80 44
