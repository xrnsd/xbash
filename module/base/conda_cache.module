#!/opt/homebrew/bin/bash
# Cache Conda's Bash hook and automatic base-environment activation.
#
# Conda normally starts a Python process twice for every new login shell:
# once to create its Bash hook and once to activate the default environment.
# The generated shell code is deterministic for the same Conda state and
# incoming shell environment, so it is safe to reuse until either changes.

_xbash_load_conda_cache()
{
    local conda_exe="$1"
    local conda_env_name="${2:-base}"
    local conda_root
    local conda_history
    local cache_dir
    local cache_key
    local cache_file
    local cache_temp
    local hook_output
    local hook_last_line

    [[ -x "$conda_exe" ]] || return 1

    conda_root=$(cd "$(dirname "$conda_exe")/.." && pwd -P) || return 1
    conda_history="${conda_root}/conda-meta/history"
    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/xbash/conda"

    # The activation output contains PATH, PS1, and Conda state.  Include all
    # of them in the key so a different incoming shell always uses Conda's
    # official generator rather than a cache created for another environment.
    cache_key=$({
        printf '%s\n' \
            "$conda_exe" \
            "$conda_env_name" \
            "$PATH" \
            "${PS1-__XBASH_UNSET__}" \
            "${CONDA_SHLVL-__XBASH_UNSET__}" \
            "${CONDA_PREFIX-__XBASH_UNSET__}"
        stat -f '%m' "$conda_exe" "$conda_history" 2>/dev/null
    } | cksum | awk '{print $1 "-" $2}') || return 1
    cache_file="${cache_dir}/bash-${cache_key}.module"

    if [[ "${XBASH_CONDA_CACHE_REFRESH:-false}" != "true" &&
          -s "$cache_file" ]]; then
        source "$cache_file"
        return 0
    fi

    mkdir -p "$cache_dir" || return 1
    cache_temp=$(mktemp "${cache_file}.XXXXXX") || return 1
    hook_output=$("$conda_exe" shell.bash hook) || return 1
    hook_last_line="${hook_output##*$'\n'}"

    # `conda shell.bash hook` ends by running `conda activate base` when
    # auto-activation is enabled.  Cache the generated activation code too,
    # otherwise sourcing the hook still starts Conda once per terminal.
    if [[ "$hook_last_line" == "conda activate "* ]]; then
        hook_output="${hook_output%$'\n'*}"
        printf '%s\n' "$hook_output" > "$cache_temp"
        "$conda_exe" shell.bash activate "$conda_env_name" >> "$cache_temp" || return 1
    else
        printf '%s\n' "$hook_output" > "$cache_temp"
    fi

    mv -f "$cache_temp" "$cache_file" || return 1
    source "$cache_file"
}

_xbash_load_conda_cache "$@"
_xbash_conda_cache_status=$?
unset -f _xbash_load_conda_cache
return "$_xbash_conda_cache_status"
